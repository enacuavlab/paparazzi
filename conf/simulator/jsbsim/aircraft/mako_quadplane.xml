  <flight_control name="actuator_dynamics">
    <property value="26.">fcs/motor_lag</property>
    <property value="20.">fcs/servo_lag</property>
    <property value="27.4">fcs/pusher_lag</property>
    <channel name="filtering">
      <!--First order filter represents actuator dynamics-->
      <lag_filter name="motor_front_right_lag">
        <input> fcs/MOTOR_FRONT_RIGHT </input>
        <clipto>
          <min>0</min>
          <max>1</max>
        </clipto>
        <c1> fcs/motor_lag </c1>
        <output> fcs/motor_front_right_lag</output>
      </lag_filter>
      <lag_filter name="motor_front_left_lag">
        <input> fcs/MOTOR_FRONT_LEFT </input>
        <clipto>
          <min>0</min>
          <max>1</max>
        </clipto>
        <c1> fcs/motor_lag </c1>
        <output> fcs/motor_front_left_lag</output>
      </lag_filter>
      <lag_filter name="motor_back_right_lag">
        <input> fcs/MOTOR_BACK_RIGHT </input>
        <clipto>
          <min>0</min>
          <max>1</max>
        </clipto>
        <c1> fcs/motor_lag </c1>
        <output> fcs/motor_back_right_lag</output>
      </lag_filter>
      <lag_filter name="motor_back_left_lag">
        <input> fcs/MOTOR_BACK_LEFT </input>
        <clipto>
          <min>0</min>
          <max>1</max>
        </clipto>
        <c1> fcs/motor_lag </c1>
        <output> fcs/motor_back_left_lag</output>
      </lag_filter>
      <lag_filter name="motor_pusher_lag">
        <input> fcs/THRUST_X </input>
        <clipto>
          <min>0</min>
          <max>1</max>
        </clipto>
        <c1>fcs/pusher_lag</c1>
        <output> fcs/motor_pusher_lag</output>
      </lag_filter>
      <actuator name="ailevon_right_lag">
        <input>fcs/ELEVON_RIGHT</input>
        <lag>fcs/servo_lag</lag>
        <rate_limit>31.25</rate_limit>
        <clipto>
          <min>-1</min>
          <max>1</max>
        </clipto>
        <output>fcs/ailevon_right_lag</output>
      </actuator>
      <actuator name="ailevon_left_lag">
        <input>fcs/ELEVON_LEFT</input>
        <lag>fcs/servo_lag</lag>
        <rate_limit>31.25</rate_limit>
        <clipto>
          <min>-1</min>
          <max>1</max>
        </clipto>
        <output>fcs/ailevon_left_lag</output>
      </actuator>
      <fcs_function>
        <function>
          <sum>
            <property>fcs/ailevon_right_lag</property>
            <property>-fcs/ailevon_left_lag</property>
          </sum>
        </function>
        <output> fcs/aileron_lag </output>
      </fcs_function>
      <fcs_function>
        <function>
          <product>
            <sum>
              <property>fcs/ailevon_right_lag</property>
              <property>fcs/ailevon_left_lag</property>
            </sum>
            <value> 0.5 </value>
          </product>
        </function>
        <output> fcs/elevator_lag </output>
      </fcs_function>
    </channel>
