<!DOCTYPE module SYSTEM "module.dtd">

<module name="guidance_indi_hybrid_tiltrotor" dir="guidance" task="control">
    <doc>
        <description>
            Guidance controller for hybrid tilt-rotors
        </description>

        <section name="GUIDANCE_INDI" prefix="GUIDANCE_INDI_">
            <define name="PUSHER_INDEX"         value="4"            description="Stabilization actuator index with non-zero Ax effectiveness, used to bound forward thrust increment [-]"/>
            <define name="MASS"                 value="0.75"         description="Vehicle mass [kg]"/>
            <define name="WING_AREA"            value="0.5"          description="Wing reference area [m^2]"/>
            <define name="CL_0"                 value="0.1"          description="Zero-alpha lift coefficient [-]"/>
            <define name="CL_ALPHA"             value="5.0"          description="Lift slope [1/rad]"/>
            <define name="MAX_ACC_BODY_X"       value="5.0"          description="Max longitudinal body acceleration [m/s^2]"/>
            <define name="MAX_ACC_BODY_Z"       value="5.0"          description="Max vertical body acceleration [m/s^2]"/>
            <define name="WLS_PRIORITIES"       value="{2.,2.,1.}"    description="WLS cost weights for ax, ay, az [-]"/>
            <define name="MIN_PITCH"            value="-40."         description="Min pitch attitude setpoint [deg]"/>
            <define name="MAX_PITCH"            value="40."          description="Max pitch attitude setpoint [deg]"/>
            <define name="PITCH_PREF_DEG"       value="0.0"          description="Preferred pitch angle for WLS, positive nose up [deg]"/>
            <define name="PITCH_PREF_RC_MIN_DEG" value="-10.0"       description="Pitch preference at tilt wheel (RADIO_TILT) minimum in GUIDED mode [deg]"/>
            <define name="PITCH_PREF_RC_MAX_DEG" value="20.0"        description="Pitch preference at tilt wheel (RADIO_TILT) maximum in GUIDED mode [deg]"/>
            <define name="WU_PITCH"             value="100.0"        description="Pitch preference weight; objectives carry gamma_sq*Wv = 1e5 [-]"/>
        </section>
    </doc>
    <dep>
        <depends>guidance_indi_hybrid,eff_scheduling_atlas</depends>
        <conflicts>guidance_indi_hybrid_tailsitter, guidance_indi_hybrid_quadplane</conflicts>
        <provides>guidance,attitude_command</provides>
    </dep>
    <header>
        <file name="guidance_indi_hybrid_tiltrotor.h"/>
    </header>
    <makefile target="ap|nps" firmware="rotorcraft">
        <define name="GUIDANCE_INDI_HYBRID_USE_WLS" value="1"/>
        <!-- Guidance actuators: (roll, pitch, thrust_z, thrust_x) for tiltrotors  -->
        <define name="GUIDANCE_INDI_HYBRID_U" value="4"/>
        <!-- Guidance control objectives: ax, ay, az for tiltrotors -->
        <define name="GUIDANCE_INDI_HYBRID_V" value="3"/>
        <define name="GUIDANCE_INDI_PUSHER_INDEX"        value="4"/>
        <define name="GUIDANCE_INDI_MASS"                value="0.68"/>
        <define name="GUIDANCE_INDI_WING_AREA"           value="0.5"/>
        <define name="GUIDANCE_INDI_CL_0"                value="0.1"/>
        <define name="GUIDANCE_INDI_CL_ALPHA"            value="5.0"/>
        <define name="GUIDANCE_INDI_MAX_ACC_BODY_X"      value="10.0"/>
        <define name="GUIDANCE_INDI_MAX_ACC_BODY_Z"      value="8.0"/>
        <define name="GUIDANCE_INDI_WLS_PRIORITIES"      value="{2.5,2.5,1.0}"/>
        <define name="GUIDANCE_INDI_MIN_PITCH"           value="-40."/>
        <define name="GUIDANCE_INDI_MAX_PITCH"           value="40."/>
        <define name="GUIDANCE_INDI_PITCH_PREF_DEG"      value="0.0"/>
        <define name="GUIDANCE_INDI_PITCH_PREF_RC_MIN_DEG" value="-5.0"/>
        <define name="GUIDANCE_INDI_PITCH_PREF_RC_MAX_DEG" value="15.0"/>
        <define name="GUIDANCE_INDI_WU_PITCH"            value="0.0"/> <!-- 10000.0 -->
        <file name="guidance_indi_hybrid_tiltrotor.c" dir="$(SRC_FIRMWARE)/guidance"/>
    </makefile>
</module>
