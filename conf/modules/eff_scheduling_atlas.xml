<!DOCTYPE module SYSTEM "module.dtd">
<module name="eff_scheduling_atlas" dir="ctrl">
    <doc>
        <description>
            Control effectiveness scheduler for the Atlas tiltrotor with two tilt banks (right/left), each carrying 2 rotors in a quad-X layout.

            Body axes: x forward, y right, z down. Tilt angle alpha = 0 for vertical rotors (hover), alpha = pi/2 for forward-pointing rotors (cruise).

            Requires the following actuators (indices defined in eff_scheduling_atlas.h):
            - 4 motors: FR (0), RR (1), RL (2), FL (3)
            - 2 tilt servos: TILT_R (4), TILT_L (5)
        </description>

        <section name="ATLAS_EFF" prefix="ATLAS_EFF_">
            <define name="IXX"             value="0"               description="MMOI about longitudinal (x) axis [kg.m^2]"/>
            <define name="IYY"             value="0"               description="MMOI about lateral (y) axis [kg.m^2]"/>
            <define name="IZZ"             value="0"               description="MMOI about vertical (z) axis [kg.m^2]"/>
            <define name="RX"              value="{0,0,0,0}"       description="Rotor x positions [m], order: FR, RR, RL, FL"/>
            <define name="RY"              value="{0,0,0,0}"       description="Rotor y positions [m], order: FR, RR, RL, FL"/>
            <define name="RZ"              value="{0,0,0,0}"       description="Rotor z positions [m], order: FR, RR, RL, FL"/>
            <define name="K_T_PPRZ"        value="{0,0,0}"         description="Quadratic thrust model: T = a + b*u + c*u^2, value = {a [N], b [N/pprz], c [N/pprz^2]}"/>
            <define name="KAPPA"           value="0"               description="Drag-torque to thrust ratio (kappa = k_m/k_t) [m]"/>
            <define name="K_LIFT"          value="0"               description="Wing lift derivative: dL/d(alpha) = k_lift * V^2 [N/rad]"/>
            <define name="V_WING"          value="10.0"            description="Airspeed at which wing lift derivative is applied [m/s]"/>
            <define name="ALPHA_MIN"       value="-0.261"            description="Minimum tilt angle [rad] (default -0.1)"/>
            <define name="ALPHA_MAX"       value="M_PI/2"          description="Maximum tilt angle [rad] (default pi/2)"/>
            <!-- Elevons
            <define name="K_ELEVON_DEFLECT"  value="0"             description="delta = k*pprz [rad/pprz], = delta_max / MAX_PPRZ"/>
            <define name="K_ELEVON_ROLL"     value="0"             description="dMx/ddelta = k_roll * V^2 [N.m/rad per (m/s)^2]"/>
            <define name="K_ELEVON_PITCH"    value="0"             description="dMy/ddelta = k_pitch * V^2 [N.m/rad per (m/s)^2]"/>
            <define name="K_ELEVON_PROPWASH" value="0.0"           description="dMy/ddelta += k_propwash * T_x * V (default 0)"/>
            -->
            <define name="TILT_RATE"       value="40.0"            description="Tilt servo angular rate limit [deg/s] (per servo)"/>
        </section>

        <section name="ATLAS_MOTOR" prefix="ATLAS_MOTOR_">
            <define name="HOVER"           value="0"               description="Motor command in hover [pprz]"/>
            <define name="IDLE"            value="0"               description="Motor command in idle [pprz]"/>
        </section>
    </doc>

    <settings>
        <dl_settings>
            <dl_settings name="eff_sched_atlas">
                <dl_setting var="atlas_eff_sched_p.m"          min="0.1"    step="0.01"    max="20"    shortname="mass"/>
                <dl_setting var="atlas_eff_sched_p.Ixx"        min="0.0001" step="0.0001"  max="1.0"   shortname="Ixx"/>
                <dl_setting var="atlas_eff_sched_p.Iyy"        min="0.0001" step="0.0001"  max="1.0"   shortname="Iyy"/>
                <dl_setting var="atlas_eff_sched_p.Izz"        min="0.0001" step="0.0001"  max="1.0"   shortname="Izz"/>
                <dl_setting var="atlas_eff_sched_p.kappa"      min="0.0001" step="0.001"   max="1.0"   shortname="kappa"/>
                <dl_setting var="atlas_eff_sched_p.k_lift"     min="0"      step="0.001"   max="5.0"   shortname="k_lift"/>
                <dl_setting var="atlas_eff_sched_p.v_wing"     min="0"      step="0.1"     max="30.0"  shortname="v_wing"/>
                <dl_setting var="atlas_eff_tilt_rate"         min="5"      step="5"       max="120"   shortname="tilt_rate"/>
                <dl_setting var="atlas_eff_disable_tilt"      min="0"      step="1"       max="1"     values="OFF|ON" shortname="disable_tilt"/>
            </dl_settings>
        </dl_settings>
    </settings>

    <header>
        <file name="eff_scheduling_atlas.h"/>
    </header>

    <init fun="eff_scheduling_atlas_init()"/>
    <periodic fun="eff_scheduling_atlas_periodic()" freq="500"/>

    <makefile>
        <define name="ACTUATORS_NB"             value="6"/> <!-- 8 with elevons: one per <servo>, all drivers -->
        <define name="ATLAS_EFF_IXX"            value="0.00372"/>
        <define name="ATLAS_EFF_IYY"            value="0.00389"/>
        <define name="ATLAS_EFF_IZZ"            value="0.01300"/>
        <define name="ATLAS_EFF_RX"             value="{0.09,-0.10,-0.10,0.09}"/>
        <define name="ATLAS_EFF_RY"             value="{0.15,0.15,-0.15,-0.15}"/>
        <define name="ATLAS_EFF_RZ"             value="{0.0,0.0,0.0,0.0}"/>
        <define name="ATLAS_EFF_SPIN_DIR"       value="{-1.0,1.0,-1.0,1.0}"/>
        <define name="ATLAS_EFF_K_T_PPRZ"       value="{0.163,1.22e-4,4.08e-8}"/>
        <define name="ATLAS_EFF_KAPPA"          value="0.018"/> <!-- was 0.06; 0.018 from log-ID: yaw eff kappa*dT/Izz~9.5e-4 with Izz=0.013 -->

        <define name="ATLAS_EFF_K_LIFT"         value="0.311"/>
        <define name="ATLAS_EFF_V_WING"         value="10.0"/>
        <define name="ATLAS_MOTOR_HOVER"        value="4640"/> <!-- was 3000; 4640 = measured hover command from flight logs -->

        <define name="ATLAS_MOTOR_IDLE"         value="0"/>
        <define name="ATLAS_EFF_ALPHA_MIN"      value="-0.261"/>
        <define name="ATLAS_EFF_ALPHA_MAX"      value="M_PI/2"/>
        <define name="ATLAS_EFF_TILT_RATE"      value="80.0"/>

        <!-- Elevons
        <define name="ATLAS_EFF_K_ELEVON_DEFLECT"  value="3.2e-5"/>  0.31 rad (18 deg) / 9600
        <define name="ATLAS_EFF_K_ELEVON_ROLL"     value="0.0"/>
        <define name="ATLAS_EFF_K_ELEVON_PITCH"    value="0.0"/>
        <define name="ATLAS_EFF_K_ELEVON_PROPWASH" value="0.0"/>
        -->
        <file name="eff_scheduling_atlas.c"/>
    </makefile>
</module>
