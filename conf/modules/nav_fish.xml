<!DOCTYPE module SYSTEM "module.dtd">

<module name="nav_fish" dir="nav" task="control">
  <doc>
    <description>
      Bio-inspired swarm navigation

      based on fish behavior as modeled in:
      Calovi DS, Litchinko A, Lecheval V, Lopez U, Perez Escudero A, Chate H, et al. (2018)
      Disentangling and modeling interactions in fish with burst-and-coast swimming reveal distinct
      alignment and attraction behaviors. PLoS Comput Biol 14(1): e1005933.
      https://doi.org/10.1371/journal.pcbi.1005933

    </description>
    <section name="NAV_FISH" prefix="NAV_FISH_">
      <define name="FLUCT" value="0.1" description="intensity of fluctuations"/>
    </section>
  </doc>
  <settings>
    <dl_settings>
      <dl_settings NAME="Nav Fish">
        <dl_settings NAME="nav">
          <dl_setting var="nav_fish_nav.speed" shortname="speed" min="0.5" step=".1" max="10.0" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_nav.alt" shortname="alt" min="0.5" step=".1" max="20.0" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_nav.vz" shortname="vz" min="-2." step=".1" max="2." module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_nav.course" shortname="course" min="0." step="1." max="360." module="modules/nav/nav_fish" unit="rad" alt_unit="deg"/>
          <dl_setting var="nav_fish_params.nb_neighbors" shortname="nb neighbors" min="1" step="1" max="4" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.intruder_id" shortname="intruder id" min="0" step="1" max="255" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.arena_radius" shortname="radius" min="5.0" step="1." max="150.0" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.use_heading" shortname="use heading" min="0" step="1" max="1" values="FALSE|TRUE" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.free_heading" shortname="free heading" min="0" step="1" max="1" values="FALSE|TRUE" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.vz_ctl" shortname="vz ctl" min="0" step="1" max="1" values="FALSE|TRUE" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.max_speed" shortname="max speed" min="0." step=".1" max="8.0" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.min_speed" shortname="min speed" min="0." step=".1" max="8.0" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.max_alt" shortname="max alt" min="0." step=".1" max="120.0" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.min_alt" shortname="min alt" min="0." step=".1" max="120.0" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.max_vz" shortname="max vz" min="0.1" step=".1" max="2.0" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.min_vz" shortname="min vz" min="-2.0" step=".1" max="-0.1" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.max_yaw" shortname="max vz" min="-90." step="1." max="90.0" module="modules/nav/nav_fish" unit="rad/s" alt_unit="deg/s"/>
        </dl_settings>
        <dl_settings NAME="params">
          <dl_setting var="nav_fish_params.y_att" shortname="y_att" min="0.01" step=".01" max="1.0" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.l_att" shortname="l_att" min="0.01" step=".1" max="20.0" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.d_att" shortname="d_att" min="2.0" step=".1" max="15.0" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.a_att" shortname="a_att" min="0.01" step=".1" max="5.0" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.y_ali" shortname="y_ali" min="0.01" step=".01" max="10.0" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.l_ali" shortname="l_ali" min="0.01" step=".1" max="20.0" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.a_ali" shortname="a_ali" min="0.01" step=".1" max="5.0" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.y_v" shortname="y_v" min="0.01" step=".01" max="10.0" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.l_v" shortname="l_v" min="0.01" step=".1" max="20.0" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.a_v" shortname="a_v" min="0.01" step=".1" max="5.0" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.y_z" shortname="y_z" min="0.01" step=".01" max="1.0" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.l_z" shortname="l_z" min="0.01" step=".1" max="5.0" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.d_z" shortname="d_z" min="0.01" step=".1" max="5.0" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.a_z" shortname="a_z" min="0.01" step=".1" max="5.0" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.y_nav" shortname="y_nav" min="0.01" step=".01" max="1.0" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.y_z_nav" shortname="y_z_nav" min="0.01" step=".01" max="1.0" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.l_z_nav" shortname="l_z_nav" min="0.01" step=".1" max="5.0" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.y_in" shortname="y_in" min="0.01" step=".01" max="10.0" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.l_in" shortname="l_in" min="0.01" step=".1" max="20.0" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.a_in" shortname="a_in" min="0.01" step=".1" max="5.0" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.y_z_in" shortname="y_z_in" min="0.01" step=".01" max="10.0" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.l_z_in" shortname="l_z_in" min="0.01" step=".1" max="20.0" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.d_z_in" shortname="d_z_in" min="0.01" step=".1" max="5.0" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.y_obs" shortname="y_obs" min="0.01" step=".01" max="10.0" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.y_v_obs" shortname="y_v_obs" min="0.01" step=".01" max="10.0" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.l_obs" shortname="l_obs" min="0.01" step=".1" max="20.0" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.a_obs" shortname="a_osb" min="0.01" step=".1" max="5.0" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.v0_obs" shortname="v0_obs" min="0.01" step=".1" max="8.0" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.y_z_obs" shortname="y_z_obs" min="0.01" step=".01" max="10.0" module="modules/nav/nav_fish"/>
          <dl_setting var="nav_fish_params.l_z_obs" shortname="l_z_obs" min="0.01" step=".1" max="20.0" module="modules/nav/nav_fish"/>
        </dl_settings>
      </dl_settings>
    </dl_settings>
  </settings>
  <dep>
    <depends>@navigation</depends>
  </dep>
  <header>
    <file name="nav_fish.h"/>
  </header>
  <init fun="nav_fish_init()"/>
  <makefile>
    <file name="nav_fish.c"/>
    <test firmware="rotorcraft">
      <define name="DOWNLINK_TRANSPORT" value="pprz_tp"/>
      <define name="DOWNLINK_DEVICE" value="uart0"/>
      <define name="USE_UART0"/>
    </test>
  </makefile>
</module>
