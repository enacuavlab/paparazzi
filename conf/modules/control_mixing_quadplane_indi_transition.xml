<!DOCTYPE module SYSTEM "module.dtd">
<module name="control_mixing_quadplane_indi_transition" dir="ctrl" task="control">
  <doc>
    <description>
      Control mixing for a quadplane.

      Four static motors in X configuration and a pusher motor for forward flight.
      Two control surfaces (elevons) for plane attitude control.
    </description>
  </doc>
  <dep>
    <conflicts>control_mixing_quadplane</conflicts>
  </dep>
  <header>
    <file name="control_mixing_quadplane_indi_transition.h"/>
  </header>
  <init fun="control_mixing_quadplane_init()"/>
  <makefile>
    <file name="control_mixing_quadplane_indi_transition.c"/>
    <test firmware="rotorcraft">
      <define name="INDI_OUTPUTS" value="5"/>
      <define name="INDI_NUM_ACT" value="7"/>
      <define name="ACTUATORS_NB" value="7"/>
      <define name="PERIODIC_FREQUENCY" value="500"/>
    </test>
  </makefile>
</module>
