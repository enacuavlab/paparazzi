<?xml version="1.0"?>
<!DOCTYPE flight_plan SYSTEM "../flight_plan.dtd">
<flight_plan alt="150" ground_alt="143" lat0="43.5634" lon0="1.48448" max_dist_from_home="80" name="Enac Carto with safety" security_height="2" wp_frame="ltp">
  <header>
    #define FP_NONE       0
    #define FP_SEARCH     1
    #define FP_SEARCH_2   2
    #define FP_DROP       3

    #ifndef SwitchServoOn
    #define SwitchServoOn(_x) {}
    #endif
    #ifndef SwitchServoOff
    #define SwitchServoOff(_x) {}
    #endif
    #define DropOpen SwitchServoOn
    #define DropClose SwitchServoOff

    #ifdef NAV_C
    #ifndef TAG_TRACKING_COORD_TO_M
    #define TAG_TRACKING_COORD_TO_M (1.f / 1000.f)
    #endif
    #ifdef SITL
    #define jevois_stream(_x) {}
    #endif

    static inline bool delay_test_rc(bool test, int delay) {
      static int nb = 0;
        if (test) {
        nb++;
        if (nb == delay) {
          nb = 0;
          return true;
        }
        return false;
      } else {
        nb = 0;
        return false;
      }
    }

    #endif
  </header>
  <waypoints>
    <waypoint name="HOME" x="-0.732" y="0.947"/>
    <waypoint name="STDBY" x="15.215" y="11.945"/>
    <waypoint name="LANDPAD" x="18.426" y="14.199"/>
    <waypoint name="RESCUE" x="-8.98" y="14.429"/>
    <waypoint name="SEARCH" x="0." y="0."/>
    <waypoint name="R1" x="19.466" y="-4.557"/>
    <waypoint name="R2" x="-4.428" y="-21.054"/>
    <waypoint name="R3" x="-21.998" y="5.08"/>
    <waypoint name="R4" x="1.133" y="21.458"/>
    <waypoint name="_FLY1" x="-8.433" y="60.016"/>
    <waypoint name="_FLY2" x="52.842" y="-25.592"/>
    <waypoint name="_FLY3" x="6.6" y="-58.499"/>
    <waypoint name="_FLY4" x="-54.3" y="25.9"/>
    <waypoint name="_KILL1" x="-7.066" y="65.666"/>
    <waypoint name="_KILL2" x="60.091" y="-26.561"/>
    <waypoint name="_KILL3" x="5.158" y="-66.664"/>
    <waypoint name="_KILL4" x="-62.023" y="26.33"/>
    <waypoint name="_HERE" x="13.836" y="-13.194"/>
    <waypoint name="SCOUT" x="14.836" y="-11.194" height="0."/>
  </waypoints>
  <sectors>
    <sector color="lime" name="Flight_Area">
      <corner name="_FLY1"/>
      <corner name="_FLY2"/>
      <corner name="_FLY3"/>
      <corner name="_FLY4"/>
    </sector>
    <sector color="red" name="Kill">
      <corner name="_KILL1"/>
      <corner name="_KILL2"/>
      <corner name="_KILL3"/>
      <corner name="_KILL4"/>
    </sector>
  </sectors>
  <variables>
    <variable init="0" type="int" var="mission_nb"/>
    <variable init="5." var="goto_height" min="2." max="20." step="0.1"/>
    <variable init="2." var="goto_speed" min="0.5" max="10." step="0.1"/>
    <variable init="2." var="takeoff_height" min="0.5" max="15." step="0.1"/>
    <variable init="1." var="land_speed" min="0.5" max="10." step="0.1"/>
    <variable init="6." var="search_height" min="4." max="20." step="0.1"/>
    <variable init="3." var="search_speed" min="0.5" max="6." step="0.1"/>
    <variable init="20." var="search_radius" min="-1." max="30." step="1.0"/>
    <variable init="4." var="search_sweep" min="1." max="20." step="0.1"/>
    <variable init="2." var="search_speed_2" min="0.5" max="6." step="0.1"/>
    <variable init="8." var="search_radius_2" min="-1." max="30." step="1.0"/>
    <variable init="2." var="search_sweep_2" min="1." max="20." step="0.1"/>
    <variable init="1.5" var="drop_height" min="1." max="3." step="0.1"/>
    <variable init="20." var="fp_max_height" min="5." max="30." step="1."/>
    <variable init="6." var="fp_search_height"/>
    <variable init="0" type="int" var="skip_goto_search" min="0" max="1" step="1"/>
  </variables>
  <modules>
    <module name="jevois">
      <configure name="JEVOIS_UART" value="UART3"/>
    </module>
    <module name="agl_dist"/>
    <module name="imav_rescue_people"/>
    <module name="scoutector"/>
  </modules>
  <exceptions>
    <exception cond="(!InsideKill(GetPosX(), GetPosY()) @OR (GetPosHeight() @GT fp_max_height+5)) @AND (nav_block @GEQ IndexOfBlock('Takeoff')) @AND (nav_block @LEQ IndexOfBlock('Flare'))" deroute="Kill landed"/>
    <exception cond="(!InsideFlight_Area(GetPosX(), GetPosY()) @OR (GetPosHeight() @GT fp_max_height)) @AND (nav_block @GEQ IndexOfBlock('Takeoff')) @AND (nav_block @LEQ IndexOfBlock('Flare'))" deroute="Standby"/>
  </exceptions>
  <blocks>
    <block name="Wait GPS">
      <call_once fun="NavKillThrottle()"/>
      <call_once fun="jevois_stream(false)"/>
      <call_once fun="DropOpen()"/>
      <while cond="!GpsFixValid()"/>
    </block>
    <block name="Geo init">
      <while cond="LessThan(NavBlockTime(), 2)"/>
      <!--call_once fun="NavSetAltitudeReferenceHere()"/-->
    </block>
    <block name="Holding point" strip_button="H. Point" group="home">
      <call_once fun="NavKillThrottle()"/>
      <attitude pitch="0" roll="0" throttle="0" until="FALSE" vmode="throttle"/>
    </block>
    <block name="Start Engine">
      <call_once fun="NavResurrect()"/>
      <attitude pitch="0" roll="0" throttle="0" until="FALSE" vmode="throttle"/>
    </block>
    <block name="Takeoff" strip_button="Takeoff" strip_icon="takeoff.png" group="home">
      <exception cond="GetPosHeight() @GT takeoff_height @AND mission_nb == FP_NONE" deroute="Standby"/>
      <exception cond="GetPosHeight() @GT takeoff_height @AND mission_nb == FP_SEARCH" deroute="Path goto search"/>
      <exception cond="GetPosHeight() @GT takeoff_height @AND mission_nb == FP_SEARCH_2" deroute="Goto Search 2"/>
      <exception cond="GetPosHeight() @GT takeoff_height @AND mission_nb == FP_DROP" deroute="Goto Drop"/>
      <call_once fun="DropClose()"/>
      <call_once fun="NavSetWaypointHere(WP_LANDPAD)"/>
      <call_once fun="NavResurrect()"/>
      <attitude pitch="0" roll="0" throttle="0" until="stage_time @GT 1" vmode="throttle"/>
      <stay climb="nav.climb_vspeed" vmode="climb" wp="LANDPAD"/>
    </block>
    <block name="Standby" strip_button="Standby" strip_icon="home.png">
      <set var="mission_nb" value="FP_NONE"/>
      <stay wp="STDBY"/>
    </block>

    <block group="mission" name="Start Search" strip_button="Search">
      <set var="mission_nb" value="FP_SEARCH"/>
      <deroute block="Takeoff"/>
    </block>
    <block name="Path goto search">
      <call_once fun="NavSetWaypointHere(WP__HERE)"/>
      <call_once fun="guidance_h_SetMaxSpeed(goto_speed)"/>
      <path wpts="_HERE,R1,R2,R3,R4" height="goto_height"/>
    </block>
    <block name="Goto Search">
      <set var="mission_nb" value="FP_NONE"/>
      <call_once fun="NavSetWaypointHere(WP__HERE)"/>
      <call_once fun="guidance_h_SetMaxSpeed(goto_speed)"/>
      <go wp="SEARCH" from="_HERE" hmode="route" height="goto_height"/>
      <stay wp="SEARCH" vmode="climb" climb="-0.5" until="(agl_dist_valid @AND (agl_dist_value_filtered @LT 2.)) @OR (!nav_is_in_flight())"/>
      <set var="fp_search_height" value="GetPosHeight()+search_height-agl_dist_value_filtered"/>
      <deroute block="Run Search"/>
    </block>
    <block name="Run Search" on_enter="jevois_stream(true)" on_exit="jevois_stream(false)">
      <!-- exception to deroute to drop if validated target -->
      <call_once fun="scout_map_reset(Ptr(scout_map))"/>
      <call_once fun="guidance_h_SetMaxSpeed(search_speed)"/>
      <for var="i" from="1" to="search_radius/search_sweep">
        <circle wp="SEARCH" radius="search_sweep*$i" height="fp_search_height" until="NavCircleCount() @GT 0.9"/>
      </for>
      <call_once fun="scout_map_update_wp(Ptr(scout_map), WP_RESCUE)"/>
      <!--call_once fun="imav_rescue_set_best_wp(WP_RESCUE)"/-->
      <deroute block="Goto Drop"/>
    </block>

    <block group="mission" name="Start Search 2" strip_button="Search 2">
      <set var="mission_nb" value="FP_SEARCH_2"/>
      <deroute block="Takeoff"/>
    </block>
    <block name="Goto Search 2">
      <set var="mission_nb" value="FP_NONE"/>
      <call_once fun="NavSetWaypointHere(WP__HERE)"/>
      <call_once fun="guidance_h_SetMaxSpeed(goto_speed)"/>
      <call_once fun="scout_map_reset(Ptr(scout_map))"/>
      <go wp="SEARCH" from="_HERE" hmode="route" height="search_height"/>
      <deroute block="Run Search 2 step 1"/>
    </block>
    <block name="Run Search 2 step 1">
      <exception cond="scout_data.snr @GT 5." deroute="Run Search 2 step 2"/>
      <call_once fun="guidance_h_SetMaxSpeed(search_speed)"/>
      <for var="i" from="1" to="search_radius/search_sweep">
        <circle wp="SEARCH" radius="search_sweep*$i" height="search_height" until="NavCircleCount() @GT 0.9"/>
      </for>
      <call_once fun="scout_map_update_wp(Ptr(scout_map), WP_RESCUE)"/>
      <!--call_once fun="imav_rescue_set_best_wp(WP_RESCUE)"/-->
      <deroute block="Goto Drop"/>
    </block>
    <block name="Run Search 2 step 2">
      <call_once fun="guidance_h_SetMaxSpeed(search_speed_2)"/>
      <call_once fun="NavSetWaypointHere(WP_SEARCH)"/>
      <call_once fun="scout_map_init(Ptr(scout_map), *stateGetPositionNed_f(), 0.5f)"/>
      <for var="i" from="1" to="search_radius_2/search_sweep_2">
        <circle wp="SEARCH" radius="search_sweep_2*$i" height="search_height" until="NavCircleCount() @GT 0.9"/>
      </for>
      <call_once fun="scout_map_update_wp(Ptr(scout_map), WP_RESCUE)"/>
      <deroute block="Goto Drop"/>
    </block>

    <block group="mission" name="Start Drop" strip_button="Drop">
      <set var="mission_nb" value="FP_DROP"/>
      <deroute block="Takeoff"/>
    </block>
    <block name="Goto Drop">
      <set var="mission_nb" value="FP_NONE"/>
      <call_once fun="NavSetWaypointHere(WP__HERE)"/>
      <call_once fun="guidance_h_SetMaxSpeed(goto_speed)"/>
      <!--stay wp="_HERE" until="stage_time @GT 3" height="fp_search_height"/-->
      <go wp="RESCUE" from="_HERE" hmode="route" height="fp_search_height"/>
      <deroute block="Drop Medikit"/>
    </block>
    <block name="Drop Medikit" on_enter="jevois_stream(true)" on_exit="jevois_stream(false)">
      <stay wp="RESCUE" until="stage_time @GT 3" height="fp_search_height"/>
      <stay wp="RESCUE" vmode="climb" climb="-0.5" until="(agl_dist_valid @AND (agl_dist_value_filtered @LT drop_height)) @OR (GetPosHeight() @LT 0.5) @OR (!nav_is_in_flight())"/>
      <call_once fun="DropOpen()"/>
      <stay wp="RESCUE" until="stage_time @GT 3" height="goto_height"/>
    </block>
    <block name="Path goto land">
      <call_once fun="NavSetWaypointHere(WP__HERE)"/>
      <call_once fun="guidance_h_SetMaxSpeed(goto_speed)"/>
      <path wpts="RESCUE,R1,R2,R3,R4" height="goto_height"/>
      <deroute block="Landing"/>
    </block>
    <block name="Land here" strip_button="Land here" strip_icon="land-right.png" group="land">
      <call_once fun="NavSetWaypointHere(WP_LANDPAD)"/>
      <deroute block="Flare"/>
    </block>
    <block name="Landing" strip_button="Land on pad" group="land">
      <call_once fun="NavSetWaypointHere(WP__HERE)"/>
      <call_once fun="guidance_h_SetMaxSpeed(goto_speed)"/>
      <go wp="STDBY" from="_HERE" hmode="route" height="goto_height"/>
      <call_once fun="guidance_h_SetMaxSpeed(land_speed)"/>
      <go wp="LANDPAD" from="STDBY" hmode="route" height="goto_height"/>
    </block>
    <block name="Flare">
      <exception cond="!nav_is_in_flight()" deroute="Kill landed"/>
      <call_once fun="guidance_h_SetMaxSpeed(land_speed)"/>
      <stay wp="LANDPAD" height="goto_height" until="stage_time @GT4"/>
      <stay climb="nav.descend_vspeed" vmode="climb" wp="LANDPAD"/>
    </block>
    <block name="Kill landed">
      <call_once fun="NavKillThrottle()"/>
      <attitude pitch="0" roll="0" throttle="0" until="FALSE" vmode="throttle"/>
    </block>

  </blocks>

</flight_plan>
