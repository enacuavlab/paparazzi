<?xml version="1.0"?>
<!DOCTYPE flight_plan SYSTEM "../flight_plan.dtd">
<flight_plan alt="152" ground_alt="147" lat0="43.5634" lon0="1.48448" max_dist_from_home="80" name="Enac Carto with safety" security_height="2" wp_frame="ltp">
  <header>

    #ifndef SwitchServoOn
    #define SwitchServoOn(_x) {}
    #endif
    #ifndef SwitchServoOff
    #define SwitchServoOff(_x) {}
    #endif
    #define DropOpen SwitchServoOn
    #define DropClose SwitchServoOff

  </header>
  <waypoints>
    <waypoint name="HOME" x="-0.732" y="0.947"/>
    <waypoint name="STDBY" x="15.215" y="11.945"/>
    <waypoint name="LANDPAD" x="18.426" y="14.199"/>
    <waypoint name="S1" x="2.749" y="26.197"/>
    <waypoint name="S2" x="-21.562" y="9.824"/>
    <waypoint name="S3" x="-2.699" y="-17.945"/>
    <waypoint name="S4" x="21.696" y="-1.571"/>
    <waypoint name="R1" x="-30.573" y="15.616"/>
    <waypoint name="R2" x="-25.038" y="19.001"/>
    <waypoint name="R3" x="-19.513" y="22.543"/>
    <waypoint name="RESCUE" x="-8.98" y="14.429"/>
    <waypoint name="WATER" x="-6.593" y="8.092"/>
    <waypoint name="DROP" x="4.988" y="-7.253"/>
    <waypoint name="_FLY1" x="-8.433" y="60.016"/>
    <waypoint name="_FLY2" x="52.842" y="-25.592"/>
    <waypoint name="_FLY3" x="6.6" y="-58.499"/>
    <waypoint name="_FLY4" x="-54.3" y="25.9"/>
    <waypoint name="_KILL1" x="-7.066" y="65.666"/>
    <waypoint name="_KILL2" x="60.091" y="-26.561"/>
    <waypoint name="_KILL3" x="5.158" y="-66.664"/>
    <waypoint name="_KILL4" x="-62.023" y="26.33"/>
    <waypoint name="_HERE" x="13.836" y="-13.194"/>
  </waypoints>
  <sectors>
    <sector color="lime" name="Flight_Area">
      <corner name="_FLY1"/>
      <corner name="_FLY2"/>
      <corner name="_FLY3"/>
      <corner name="_FLY4"/>
    </sector>
    <sector color="red" name="Kill">
      <corner name="_KILL1"/>
      <corner name="_KILL2"/>
      <corner name="_KILL3"/>
      <corner name="_KILL4"/>
    </sector>
    <sector color="yellow" name="Survey">
      <corner name="S1"/>
      <corner name="S2"/>
      <corner name="S3"/>
      <corner name="S4"/>
    </sector>
  </sectors>
  <variables>
    <variable init="20." var="fp_max_height" min="5." max="30." step="1."/>
    <variable init="5." var="goto_height" min="2." max="20." step="0.1"/>
    <variable init="4." var="goto_speed" min="0.5" max="10." step="0.1"/>
    <variable init="1." var="land_speed" min="0.5" max="10." step="0.1"/>
    <variable init="7." var="survey_height" min="5." max="80." step="0.1"/>
    <variable init="6." var="survey_sweep" min="5." max="20." step="0.1"/>
    <variable init="3." var="survey_speed" min="0.5" max="10." step="0.1"/>
    <variable init="-1." var="survey_radius" min="-1." max="100." step="1.0"/>
    <variable init="8." var="search_height" min="4." max="20." step="0.1"/>
    <variable init="3." var="search_speed" min="0.5" max="6." step="0.1"/>
    <variable init="15." var="search_radius" min="-1." max="30." step="1.0"/>
    <variable init="4." var="search_sweep" min="1." max="20." step="0.1"/>
    <variable init="2." var="drop_height" min="1." max="3." step="0.1"/>
    <variable init="1." var="water_height" min="0." max="80." step="0.1"/>
    <variable init="1." var="water_speed" min="0.5" max="10." step="0.1"/>
    <variable init="30." var="water_duration" min="1." max="60." step="1."/>
    <variable init="50." var="water_timeout" min="10." max="120." step="1."/>
    <variable init="30." var="water_purge" min="1." max="60." step="1."/>
    <variable init="1." var="water_height_target"/>
  </variables>
  <modules>
    <module name="nav" type="survey_hybrid">
      <define name="SURVEY_HYBRID_MAX_SWEEP_BACK" value="1"/>
      <define name="SURVEY_HYBRID_APPROACHING_TIME" value="0"/>
      <define name="SURVEY_HYBRID_ENTRY_DISTANCE" value="0"/>
      <define name="SURVEY_HYBRID_ENTRY_CIRCLE" value="FALSE"/>
    </module>
    <module name="jevois">
      <configure name="JEVOIS_UART" value="UART3"/>
    </module>
    <module name="agl_dist"/>
    <module name="pump_control"/>
    <module name="agl_dist"/>
    <module name="imav_rescue_people"/>
  </modules>
  <exceptions>
    <exception cond="(!InsideKill(GetPosX(), GetPosY()) @OR (GetPosHeight() @GT fp_max_height+5)) @AND (nav_block @GEQ IndexOfBlock('Takeoff')) @AND (nav_block @LEQ IndexOfBlock('Flare'))" deroute="Emergency"/>
    <exception cond="(!InsideFlight_Area(GetPosX(), GetPosY()) @OR (GetPosHeight() @GT fp_max_height)) @AND (nav_block @GEQ IndexOfBlock('Takeoff')) @AND (nav_block @LEQ IndexOfBlock('Flare'))" deroute="Standby"/>
  </exceptions>
  <blocks>
    <block name="Wait GPS">
      <call_once fun="NavKillThrottle()"/>
      <while cond="!GpsFixValid()"/>
    </block>
    <block name="Geo init">
      <while cond="LessThan(NavBlockTime(), 2)"/>
      <!--call_once fun="NavSetAltitudeReferenceHere()"/-->
    </block>
    <block name="Holding point">
      <call_once fun="NavKillThrottle()"/>
      <attitude pitch="0" roll="0" throttle="0" until="FALSE" vmode="throttle"/>
    </block>
    <block name="Start Engine">
      <call_once fun="NavResurrect()"/>
      <attitude pitch="0" roll="0" throttle="0" until="FALSE" vmode="throttle"/>
    </block>
    <block name="Takeoff" strip_button="Takeoff" strip_icon="takeoff.png">
      <exception cond="stateGetPositionEnu_f() @DEREF z @GT 2.0" deroute="Standby"/>
      <call_once fun="NavSetWaypointHere(WP_LANDPAD)"/>
      <call_once fun="NavResurrect()"/>
      <attitude pitch="0" roll="0" throttle="0" until="stage_time @GT 1" vmode="throttle"/>
      <stay climb="nav.climb_vspeed" vmode="climb" wp="LANDPAD"/>
    </block>
    <block name="Standby" strip_button="Standby" strip_icon="home.png">
      <stay wp="STDBY"/>
    </block>

    <block name="Goto Survey" strip_button="Survey">
      <call_once fun="guidance_h_SetMaxSpeed(survey_speed)"/>
      <call_once fun="NavSetWaypointHere(WP__HERE)"/>
      <go wp="S1" from="_HERE" hmode="route" height="survey_height"/>
      <stay wp="S1" height="survey_height" until="stage_time @GT 3"/>
      <call_once fun="nav_survey_hybrid_setup_towards(WP_S1, WP_S2, 4, survey_sweep, survey_radius, survey_height)"/>
      <deroute block="Run Survey"/>
    </block>
    <block name="Run Survey">
      <call_once fun="guidance_h_SetMaxSpeed(survey_speed)"/>
      <call fun="nav_survey_hybrid_run()"/>
      <deroute block="Standby"/>
    </block>

    <block name="Goto Search" strip_button="Rescue">
      <call_once fun="NavSetWaypointHere(WP__HERE)"/>
      <call_once fun="guidance_h_SetMaxSpeed(goto_speed)"/>
      <go wp="HOME" from="_HERE" hmode="route" height="search_height"/>
      <deroute block="Run Search"/>
    </block>
    <block name="Run Search" on_enter="jevois_stream(true)" on_exit="jevois_stream(false)">
      <!-- exception to deroute to drop if validated target -->
      <call_once fun="guidance_h_SetMaxSpeed(search_speed)"/>
      <for var="i" from="1" to="search_radius/search_sweep">
        <circle wp="HOME" radius="search_sweep*$i" height="search_height" until="NavCircleCount() @GT 1."/>
      </for>
      <call_once fun="imav_rescue_set_best_wp(WP_RESCUE)"/>
      <deroute block="Drop Medikit"/>
    </block>

    <block name="Goto Drop Medikit">
      <call_once fun="NavSetWaypointHere(WP__HERE)"/>
      <call_once fun="guidance_h_SetMaxSpeed(goto_speed)"/>
      <stay wp="_HERE" until="stage_time @GT 3" height="goto_height"/>
      <go wp="RESCUE" from="_HERE" hmode="route" height="goto_height"/>
      <deroute block="Drop Medikit"/>
    </block>
    <block name="Drop Medikit" on_enter="jevois_stream(true)" on_exit="jevois_stream(false)">
      <stay wp="RESCUE" until="stage_time @GT 3" height="search_height"/>
      <stay wp="RESCUE" vmode="climb" climb="-0.5" until="(agl_dist_valid @AND (agl_dist_value_filtered @LT drop_height)) @OR (GetPosHeight() @LT 0.5) @OR (!nav_is_in_flight())"/>
      <call_once fun="DropOpen()"/>
      <stay wp="RESCUE" until="stage_time @GT 3" height="goto_height"/>
      <deroute block="Standby"/>
    </block>

    <block name="Goto Water">
      <call_once fun="NavSetWaypointHere(WP__HERE)"/>
      <call_once fun="guidance_h_SetMaxSpeed(goto_speed)"/>
      <stay wp="_HERE" until="stage_time @GT 3" height="goto_height"/>
      <go wp="WATER" from="_HERE" hmode="route" height="goto_height" approaching_time="2"/>
      <deroute block="Fill Tank"/>
    </block>
    <block name="Fill Tank" on_exit="pump_stop()">
      <call_once fun="guidance_h_SetMaxSpeed(water_speed)"/>
      <stay wp="WATER" height="goto_height" until="stage_time @GT 2"/>
      <stay wp="WATER" vmode="climb" climb="-0.6" until="GetPosHeight() @LT water_height + 3"/>
      <stay wp="WATER" vmode="climb" climb="-0.3" until="(agl_dist_valid @AND (agl_dist_value_filtered @LT water_height)) @OR pump_pumping()"/>
      <set var="water_height_target" value="GetPosHeight()"/>
      <call_once fun="pump_activate()"/>
      <stay wp="WATER" vmode="climb" climb="0" until="pump_done(water_duration, water_timeout)"/>
      <!-- <stay wp="WATER" height="water_height_target" until="pump_done(water_duration, water_timeout)"/> -->
      <deroute block="Goto Drop Water"/>
    </block>
    <block name="Goto Drop Water">
      <call_once fun="NavSetWaypointHere(WP__HERE)"/>
      <call_once fun="guidance_h_SetMaxSpeed(goto_speed)"/>
      <stay wp="_HERE" until="stage_time @GT 3" height="goto_height"/>
      <go wp="DROP" from="_HERE" hmode="route" height="goto_height"/>
      <deroute block="Drop Water"/>
    </block>
    <block name="Drop Water" on_exit="pump_stop()">
      <call_once fun="guidance_h_SetMaxSpeed(water_speed)"/>
      <stay wp="DROP" height="goto_height" until="stage_time @GT 2"/>
      <stay wp="DROP" height="water_height" until="GetPosHeight() @LT water_height + 0.5"/>
      <call_once fun="pump_purge()"/>
      <stay wp="DROP" height="water_height" until="stage_time @GT 30"/>
      <deroute block="Goto Water"/>
    </block>

    <block name="Land here" strip_button="Land Here" strip_icon="land-right.png" group="land">
      <call_once fun="NavSetWaypointHere(WP_LANDPAD)"/>
    </block>
    <block name="Flare">
      <exception cond="!nav_is_in_flight()" deroute="Landing Done"/>
      <call_once fun="guidance_h_SetMaxSpeed(land_speed)"/>
      <stay wp="LANDPAD" height="goto_height" until="stage_time @GT4"/>
      <stay climb="nav.descend_vspeed" vmode="climb" wp="LANDPAD"/>
    </block>
    <block name="Landing Done">
      <attitude pitch="0" roll="0" throttle="0" until="FALSE" vmode="throttle"/>
    </block>
    <block name="Emergency">
      <call_once fun="NavKillThrottle()"/>
      <attitude pitch="0" roll="0" throttle="0" until="FALSE" vmode="throttle"/>
    </block>
  </blocks>
</flight_plan>
