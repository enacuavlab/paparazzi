<!DOCTYPE flight_plan SYSTEM "../flight_plan.dtd">

<flight_plan alt="147" ground_alt="146" lat0="43.5640917" lon0="1.4829201" wp_frame="ltp" max_dist_from_home="20" name="Swarm Fish (ENAC indoor)" security_height="0.3">
  <header>
  </header>
  <waypoints>
    <waypoint name="HOME" x="0.0" y="0.0"/>
    <waypoint name="STDBY" x="-0.7" y="-0.8"/>
    <waypoint name="_N1" x="4.5" y="5.2"/>
    <waypoint name="_N2" x="4.5" y="-5.2"/>
    <waypoint name="_N3" x="-4.5" y="-5.2"/>
    <waypoint name="_N4" x="-4.5" y="5.2"/>
    <waypoint name="_S1" x="4" y="4."/>
    <waypoint name="_S2" x="4" y="-4."/>
    <waypoint name="_S3" x="-4" y="-4."/>
    <waypoint name="_S4" x="-4" y="4."/>
  </waypoints>
  <sectors>
    <sector name="Net" color="red">
      <corner name="_N1"/>
      <corner name="_N2"/>
      <corner name="_N3"/>
      <corner name="_N4"/>
    </sector>
    <sector name="Safety" color="green">
      <corner name="_S1"/>
      <corner name="_S2"/>
      <corner name="_S3"/>
      <corner name="_S4"/>
    </sector>
  </sectors>
  <modules>
    <module name="swarm_fish"/>
  </modules>
  <exceptions>
    <exception cond="(!InsideSafety(GetPosX(), GetPosY()) @OR (GetPosHeight() @GT 7.)) @AND (nav_block @GEQ IndexOfBlock('Takeoff')) @AND (nav_block @LT IndexOfBlock('Flare'))" deroute="Standby"/>
  </exceptions>
  <blocks>
    <block name="Wait GPS">
      <call_once fun="NavKillThrottle()"/>
      <while cond="!GpsFixValid()"/>
    </block>
    <block name="Holding point" group="home">
      <call_once fun="NavKillThrottle()"/>
      <attitude pitch="0" roll="0" throttle="0" until="FALSE" vmode="throttle"/>
    </block>
    <block name="Start Engine">
      <call_once fun="NavResurrect()"/>
      <attitude pitch="0" roll="0" throttle="0" until="FALSE" vmode="throttle"/>
    </block>
    <block name="Takeoff" strip_button="Takeoff" strip_icon="takeoff.png" group="home">
      <exception cond="GetPosHeight() @GT 0.8" deroute="Standby"/>
      <call_once fun="NavResurrect()"/>
      <attitude pitch="0" roll="0" throttle="0.1" vmode="throttle" until="stage_time @GT 2"/>
      <call_once fun="NavSetWaypointHere(WP_STDBY)"/>
      <stay vmode="climb" climb="nav.climb_vspeed" wp="STDBY"/>
    </block>
    <block name="Standby" strip_button="Standby" strip_icon="home.png" group="home">
      <stay wp="STDBY"/>
    </block>
    <block group="fish" name="Nav Fish" strip_button="Swarm Nav">
      <guided flags="GUIDED_FLAG_XY_VEL|GUIDED_FLAG_YAW_RATE|GUIDED_FLAG_Z_VEL" commands="swarm_fish.speed_sp.y, swarm_fish.speed_sp.x, -swarm_fish.speed_sp.z, -swarm_fish.yaw_rate_sp" pre_call="swarm_fish_velocity_run()"/>
    </block>
    <block name="Land Here" strip_button="Land Here" group="home">
     <call_once fun="NavSetWaypointHere(WP_STDBY)"/>
    </block>
    <block name="Land" strip_button="Land" strip_icon="land-right.png" group="home">
      <go wp="STDBY"/>
    </block>
    <block name="Flare">
      <!--exception cond="NavDetectGround()" deroute="Holding point"/-->
      <exception cond="!nav_is_in_flight()" deroute="Kill landed"/>
      <!--call_once fun="NavStartDetectGround()"/-->
      <stay climb="nav.descend_vspeed" vmode="climb" wp="STDBY"/>
    </block>
    <block name="Kill landed">
      <call_once fun="NavKillThrottle()"/>
      <attitude pitch="0" roll="0" throttle="0" until="FALSE" vmode="throttle"/>
    </block>
  </blocks>
</flight_plan>
