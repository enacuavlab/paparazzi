<?xml version="1.0"?>
<!DOCTYPE flight_plan SYSTEM "../../flight_plan.dtd">
<flight_plan alt="125" ground_alt="112" lat0="48.8615012" lon0="1.8971233" max_dist_from_home="300" name="COHOMA3" security_height="5" qfu="80" home_mode_height="10">
  <header>
    static inline bool delay_test_rc(bool test, int delay) {
      static int nb = 0;
        if (test) {
        nb++;
        if (nb == delay) {
          nb = 0;
          return true;
        }
        return false;
      } else {
        nb = 0;
        return false;
      }
    }

    static inline bool delay_test_gf(bool test, int delay) {
      static int nb = 0;
      if (test) {
        nb++;
        if (nb == delay) {
          nb = 0;
          return true;
        }
        return false;
      } else {
        nb = 0;
        return false;
      }
    }
  </header>
  <waypoints>
    <waypoint name="HOME" lat="48.8617" lon="1.89775"/>
    <waypoint name="STDBY" lat="48.8616884" lon="1.8975348"/>
    <waypoint name="LANDPAD" height="0" lat="48.8616946" lon="1.8974178"/>
    <waypoint name="P1" lat="48.8616" lon="1.89803"/>
    <waypoint x="45.569" y="-37.116" name="_HERE"/>
    <waypoint name="_KILL1" lat="48.8611" lon="1.89955"/>
    <waypoint name="_KILL2" lat="48.8614" lon="1.89602"/>
    <waypoint name="_KILL3" lat="48.8623" lon="1.89747"/>
    <waypoint name="_KILL4" lat="48.8625" lon="1.89896"/>
    <waypoint name="_KILL5" lat="48.8624" lon="1.90066"/>
    <waypoint name="_FLY1" lat="48.8612" lon="1.89942"/>
    <waypoint name="_FLY2" lat="48.8614537" lon="1.8964333"/>
    <waypoint name="_FLY3" lat="48.8622" lon="1.8976"/>
    <waypoint name="_FLY4" lat="48.8624" lon="1.89898"/>
    <waypoint name="_FLY5" lat="48.8623" lon="1.9004"/>
  </waypoints>
  <sectors>
    <sector name="KillZone" color="red">
      <corner name="_KILL1"/>
      <corner name="_KILL2"/>
      <corner name="_KILL3"/>
      <corner name="_KILL4"/>
      <corner name="_KILL5"/>
    </sector>
    <sector name="FlyZone" color="yellow">
      <corner name="_FLY1"/>
      <corner name="_FLY2"/>
      <corner name="_FLY3"/>
      <corner name="_FLY4"/>
      <corner name="_FLY5"/>
    </sector>
  </sectors>
  <variables>
    <variable var="fp_max_height" type="float" init="100." min="10." max="50." step="1."/>
    <variable var="fp_height" init="15." type="float" min="5." max="30." step="1."/>
    <variable var="fp_speed" init="4." type="float" min="1." max="15." step="1."/>
  </variables>
  <modules>
    <module name="mission" type="rotorcraft">
      <define name="MISSION_WAIT_TIMEOUT" value="240"/>
    </module>
    <module name="nav" type="takeoff_and_landing"/>
    <module name="nav" type="poles_rotorcraft"/>
    <module name="power_switch"/>
  </modules>
  <exceptions>
    <!-- RC-Loss + datalink loss -->
    <exception cond="(delay_test_rc(RadioControlIsLost(),20) @AND (datalink_time @GT 10) @AND       !(IndexOfBlock('Takeoff') @GT nav_block) @AND       !(nav_block @GEQ IndexOfBlock('Kill landed')) @AND       (autopilot_in_flight() == true) )" deroute="EmergencyLanding"/>

    <!-- Datalink loss -->
    <exception cond="(datalink_time @GT 10 @AND       !(IndexOfBlock('Takeoff') @GT nav_block) @AND       !(nav_block @GEQ IndexOfBlock('Kill landed')) @AND       (autopilot_in_flight() == true) )" deroute="Standby"/>

    <!-- Geofence -->
    <exception cond="((!InsideFlyZone(GetPosX(), GetPosY()) @OR GetPosHeight() @GT fp_max_height) @AND       !(IndexOfBlock('Takeoff') @GT nav_block) @AND       !(nav_block @GEQ IndexOfBlock('Kill landed')) @AND       (autopilot_in_flight() == true) )" deroute="Standby"/>
    <exception cond="((delay_test_gf(!InsideKillZone(GetPosX(), GetPosY()),10) @OR GetPosHeight() @GT fp_max_height+10) @AND       !(IndexOfBlock('Takeoff') @GT nav_block) @AND       !(nav_block @GEQ IndexOfBlock('Kill landed')) @AND       (autopilot_in_flight() == true) )" deroute="Kill landed"/>
  </exceptions>
  <blocks>
    <block name="Wait GPS">
      <call_once fun="NavKillThrottle()"/>
      <while cond="!GpsFixValid()"/>
    </block>
    <block name="Geo init">
      <while cond="LessThan(NavBlockTime(), 3)"/>
    </block>
    <block name="Holding point">
      <call_once fun="NavKillThrottle()"/>
      <attitude pitch="0" roll="0" throttle="0" until="FALSE" vmode="throttle"/>
    </block>
    <block name="Takeoff" strip_button="Takeoff (Here)" group="takeoff">
      <call_once fun="NavSetWaypointHere(WP_LANDPAD)"/>
      <call fun="nav_takeoff_from_here(-1.)"/>
      <deroute block="Standby"/>
    </block>
    <block name="Standby" strip_button="Standby" strip_icon="home.png">
      <stay wp="STDBY" max_speed="fp_speed"/>
    </block>
    <block name="Goto P1">
      <set var="nav_max_speed" value="fp_speed"/>
      <go wp="P1" height="fp_height" max_speed="fp_speed"/>
      <stay wp="P1" height="fp_height" until="stage_time @GT 10" max_speed="fp_speed"/>
      <go wp="STDBY" height="fp_height" max_speed="fp_speed"/>
      <deroute block="Standby"/>
    </block>
    <block name="Mission" strip_button="Mission" on_enter="power_switch_set(true)" on_exit="power_switch_set(false)">
      <call fun="mission_run()"/>
      <deroute block="Standby"/>
    </block>
    <block name="Land (WP)" strip_button="Land (WP)" group="land">
      <call fun="nav_land_at_wp(WP_LANDPAD, WP_LANDPAD, 0.)"/>
      <deroute block="Kill landed"/>
    </block>
    <block name="Land here" strip_button="Land here" strip_icon="land-right.png" group="land">
      <call_once fun="NavSetWaypointHere(WP_LANDPAD)"/>
    </block>
    <block name="Land" strip_button="Land on pad" group="land">
      <call_once fun="NavSetWaypointHere(WP__HERE)"/>
      <go wp="LANDPAD" from="_HERE" hmode="route"/>
    </block>
    <block name="Flare">
      <exception cond="!nav_is_in_flight()" deroute="Kill landed"/>
      <stay climb="nav.descend_vspeed" vmode="climb" wp="LANDPAD"/>
    </block>
    <block name="Kill landed">
      <call_once fun="NavKillThrottle()"/>
      <attitude pitch="0" roll="0" throttle="0" until="FALSE" vmode="throttle"/>
    </block>
    <block name="EmergencyLanding">
      <stay wp="HOME" vmode="throttle" throttle="0."/>
    </block>
  </blocks>
</flight_plan>
