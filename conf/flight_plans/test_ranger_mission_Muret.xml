<?xml version="1.0"?>
<!DOCTYPE flight_plan SYSTEM "flight_plan.dtd">
<flight_plan alt="225" ground_alt="185" lat0="43.4625469" lon0="1.2732527" max_dist_from_home="600" name="Test Ranger T1 (mission)" security_height="1" home_mode_height="20" wp_frame="ltp">
  <header>
  </header>
  <waypoints>
    <waypoint name="HOME" x="10.011" y="45.283"/>
    <waypoint name="CLIMB" x="-0.987" y="1.47"/>
    <waypoint name="STDBY" x="7.868" y="16.094"/>
    <waypoint name="p1" x="-1.883" y="10.877"/>
    <waypoint name="p2" x="95.982" y="13.261"/>
    <waypoint name="p3" x="92.749" y="87.636"/>
    <waypoint name="p4" x="-26.909" y="134.229"/>
    <waypoint name="TD" x="18.456" y="-8.405" height="0."/>
    <waypoint name="_FLY1" x="-210.427" y="344.535"/>
    <waypoint name="_FLY2" x="361.91" y="272.849"/>
    <waypoint name="_FLY3" x="306.146" y="-117.204"/>
    <waypoint name="_FLY4" x="-301.288" y="30.657"/>
    <waypoint name="_KILL1" x="-224.642" y="366.52"/>
    <waypoint name="_KILL2" x="390.65" y="296.493"/>
    <waypoint name="_KILL3" x="325.256" y="-145.327"/>
    <waypoint name="_KILL4" x="-339.689" y="15.798"/>
  </waypoints>
  <sectors>
    <sector color="lime" name="Flight_Area">
      <corner name="_FLY1"/>
      <corner name="_FLY2"/>
      <corner name="_FLY3"/>
      <corner name="_FLY4"/>
    </sector>
    <sector color="red" name="Kill">
      <corner name="_KILL1"/>
      <corner name="_KILL2"/>
      <corner name="_KILL3"/>
      <corner name="_KILL4"/>
    </sector>
  </sectors>
  <variables>
    <variable init="30." type="float" var="fp_height" min="10." max="100." step="1."/>
  </variables>
  <modules>
    <module name="nav" type="takeoff_and_landing"/>
    <module name="nav" type="poles_rotorcraft"/>
    <module name="mission" type="rotorcraft"/>
    <module name="power_switch"/>
  </modules>
  <exceptions>
    <!--exception cond="Or(!InsideFlight_Area(GetPosX(), GetPosY()), GetPosAlt() @GT GetAltRef() + 50) @AND (nav_block @GEQ IndexOfBlock('Takeoff')) @AND !(nav_block == IndexOfBlock('Kill landed'))" deroute="Standby"/-->
  </exceptions>
  <blocks>
    <block name="Wait GPS">
      <call_once fun="NavKillThrottle()"/>
      <while cond="!GpsFixValid()"/>
    </block>
    <block name="Geo init">
      <while cond="LessThan(NavBlockTime(), 4)"/>
      <call_once fun="NavSetAltitudeReferenceHere()"/>
    </block>
    <block name="Holding point">
      <call_once fun="NavKillThrottle()"/>
      <attitude pitch="0" roll="0" throttle="0" until="FALSE" vmode="throttle"/>
    </block>
    <block name="Takeoff" strip_button="Takeoff" group="module">
      <call fun="nav_takeoff_from_here()"/>
      <call_once fun="power_switch_set(true)"/>
      <deroute block="Path"/>
    </block>
    <block name="Standby" strip_button="Standby" strip_icon="home.png">
      <stay wp="STDBY"/>
    </block>
    <block name="Mission" strip_button="Mission">
      <call fun="mission_run()"/>
      <deroute block="Standby"/>
    </block>
    <block name="Path">
      <path wpts="p1,p2,p3" height="fp_height"/>
    </block>
    <block name="Poles">
      <exception cond="NavOvalCount @GEQ 3" deroute="Path back"/>
      <call_once fun="nav_poles_setup_wp(WP_p3, WP_p4, fp_height, nav.radius, 1.)"/>
      <call fun="nav_poles_run()"/>
    </block>
    <block name="Path back">
      <path wpts="p3,p2,p1" height="fp_height"/>
    </block>
    <block name="Land" strip_button="Land" group="module">
      <call_once fun="power_switch_set(false)"/>
      <call fun="nav_land_at_wp(WP_TD, WP_TD, 0.)"/>
      <deroute block="Kill landed"/>
    </block>
    <block name="Kill landed">
      <attitude pitch="0" roll="0" throttle="0" until="FALSE" vmode="throttle"/>
    </block>
  </blocks>
</flight_plan>
