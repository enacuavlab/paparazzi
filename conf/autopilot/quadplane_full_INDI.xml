<!DOCTYPE autopilot SYSTEM "autopilot.dtd">

<autopilot name="Quadplane VTOL">

  <state_machine name="ap" freq="PERIODIC_FREQUENCY" gcs_mode="true" settings_mode="true" settings_handler="autopilot_generated|SetModeHandler">

    <modules>
      <module name="nav" type="rotorcraft"/>
      <module name="control_mixing" type="quadplane"/>
      <module name="stabilization" type="indi"/>
      <module name="guidance" type="indi_hybrid_quadplane"/>
    </modules>

    <includes>
      <include name="autopilot_rc_helpers.h"/>
      <define name="MODE_MANUAL" value="AP_MODE_ATTITUDE" cond="ifndef MODE_MANUAL"/>
      <define name="MODE_AUTO1" value="AP_MODE_FORWARD" cond="ifndef MODE_AUTO1"/>
      <define name="MODE_AUTO2" value="AP_MODE_NAV" cond="ifndef MODE_AUTO2"/>
    </includes>

    <settings>
      <dl_setting var="autopilot.kill_throttle" min="0" step="1" max="1" module="autopilot" values="Resurrect|Kill" handler="KillThrottle"/>
      <dl_setting var="autopilot_mode_auto2" min="0" step="1" max="1" module="autopilot" values="GUIDED|NAV"/>
    </settings>

    <control_block name="set_commands">
      <call fun="SetRotorcraftCommands(stabilization.cmd, autopilot_in_flight(), autopilot_get_motors_on())"/>
    </control_block>

    <mode_selection>
      <mode_select cond="RCMode0()" mode="MODE_MANUAL"/>
      <mode_select cond="RCMode1()" mode="MODE_AUTO1"/>
      <mode_select cond="RCMode2()" mode="MODE_AUTO2"/>
    </mode_selection>

    <exceptions>
      <exception cond="nav.too_far_from_home" deroute="HOME"/>
      <exception cond="kill_switch_is_on()" deroute="KILL"/>
    </exceptions>

    <!-- Kill throttle mode -->
    <mode name="KILL">
      <select cond="kill_switch_is_on()"/>
      <on_enter>
        <call fun="guidance_h_mode_changed(GUIDANCE_H_MODE_NONE)"/>
        <call fun="stabilization_mode_changed(STABILIZATION_MODE_NONE, 0)"/>
        <call fun="guidance_v_mode_changed(GUIDANCE_V_MODE_KILL)"/>
        <call fun="autopilot_set_in_flight(false)"/>
        <call fun="autopilot_set_motors_on(false)"/>
        <!--call fun="stabilization.cmd[COMMAND_THRUST] = 0"/-->
      </on_enter>
      <control>
        <call fun="SetCommands(commands_failsafe)"/>
      </control>
    </mode>

    <!-- Glide (same as KILL ?) -->
    <mode name="FAILSAFE" shortname="FAIL">
      <on_enter>
        <call fun="guidance_h_mode_changed(GUIDANCE_H_MODE_NONE)"/>
        <call fun="guidance_v_mode_changed(GUIDANCE_V_MODE_KILL)"/>
        <call fun="stabilization_mode_changed(STABILIZATION_MODE_ATTITUDE, STABILIZATION_ATT_SUBMODE_HEADING)"/>
        <call fun="autopilot_set_motors_on(false)"/>
      </on_enter>
      <control>
        <call fun="control_mixing_quadplane_failsafe()"/>
      </control>
      <exception cond="!GpsIsLost()" deroute="$LAST_MODE"/>
    </mode>

    <mode name="ELEVON_TEST" shortname="ELV_TEST">
      <select cond="CMQ_GROUND_ELEVON_TEST && !kill_switch_is_on()"/>

      <on_enter>
        <call fun="control_mixing_quadplane_elevon_test_enter()"/>
      </on_enter>

      <control>
        <call fun="control_mixing_quadplane_elevon_test()"/>
      </control>

      <exception cond="RadioControlIsLost()" deroute="KILL"/>
    </mode>

    <mode name="MANUAL" shortname="MAN">
      <on_enter>
        <call fun="control_mixing_quadplane_attitude_direct_enter()"/>
      </on_enter>
      <control freq="NAVIGATION_FREQUENCY">
        <call fun="nav_periodic_task()"/>
      </control>
      <control>
        <call fun="control_mixing_quadplane_attitude_direct()"/>
      </control>
      <exception cond="RadioControlIsLost()" deroute="FAILSAFE"/>
    </mode>

    <mode name="FORWARD" shortname="FWD">
      <on_enter>
        <call fun="control_mixing_quadplane_attitude_plane_enter()"/>
      </on_enter>
      <control freq="NAVIGATION_FREQUENCY">
        <call fun="nav_periodic_task()"/>
      </control>
      <control>
        <call fun="control_mixing_quadplane_attitude_plane()"/>
      </control>
      <exception cond="RadioControlIsLost()" deroute="FAILSAFE"/>
    </mode>

    <mode name="ATTITUDE" shortname="ATT">
      <on_enter>
        <call fun="control_mixing_quadplane_attitude_direct_enter()"/>
      </on_enter>
      <control freq="NAVIGATION_FREQUENCY">
        <call fun="nav_periodic_task()"/>
      </control>
      <control>
        <call fun="control_mixing_quadplane_attitude_direct()"/>
      </control>
      <exception cond="RadioControlIsLost()" deroute="FAILSAFE"/>
    </mode>



    <!-- RC Mode 2: Guided by GCS setpoints -->
    <mode name="GUIDED">
      <on_enter>
        <call fun="control_mixing_quadplane_guidance_enter()"/>
        <call fun="guidance_h_mode_changed(GUIDANCE_H_MODE_GUIDED)"/>
        <call fun="guidance_v_mode_changed(GUIDANCE_V_MODE_GUIDED)"/>
      </on_enter>
      <control freq="NAVIGATION_FREQUENCY">
        <call fun="nav_periodic_task()"/>
      </control>
      <control>
        <call fun="control_mixing_quadplane_guidance()"/>
      </control>
      <exception cond="GpsIsLost() && autopilot_in_flight()" deroute="FAILSAFE"/>
    </mode>

    <!-- RC Mode 2: Autonomous flight plan -->
    <mode name="NAV">
      <select cond="$DEFAULT_MODE"/>
      <on_enter>
        <call fun="control_mixing_quadplane_nav_enter()"/>
      </on_enter>
      <control freq="NAVIGATION_FREQUENCY">
        <call fun="nav_periodic_task()"/>
      </control>
      <control>
        <call fun="control_mixing_quadplane_nav()"/>
      </control>
      <exception cond="GpsIsLost() && autopilot_in_flight()" deroute="FAILSAFE"/>
    </mode>

    <mode name="HOME">
      <on_enter>
        <call fun="control_mixing_quadplane_nav_enter()"/>
      </on_enter>
      <control freq="NAVIGATION_FREQUENCY">
        <call fun="nav_home()"/>
      </control>
      <control>
        <call fun="control_mixing_quadplane_nav()"/>
      </control>
      <exception cond="GpsIsLost()" deroute="FAILSAFE"/>
    </mode>

  </state_machine>

</autopilot>
