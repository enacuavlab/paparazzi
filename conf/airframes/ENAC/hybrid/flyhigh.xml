  <section name="STABILIZATION_ATTITUDE" prefix="STABILIZATION_ATTITUDE_">
    <!-- setpoint limits for attitude stabilization rc flight -->
    <define name="SP_MAX_PHI"   value="45" unit="deg"/>
    <define name="SP_MAX_THETA" value="45" unit="deg"/>
    <define name="SP_MAX_R"     value="60" unit="deg/s"/>
    <define name="DEADBAND_A"   value="0"/>
    <define name="DEADBAND_E"   value="0"/>
    <define name="DEADBAND_R"   value="50"/>
  </section>

  <section name="STABILIZATION_ATTITUDE_INDI" prefix="STABILIZATION_INDI_">
    <define name="NUM_ACT"      value="7"/>
    <define name="OUTPUTS"      value="5"/>
    <!-- reference acceleration for attitude control -->
    <define name="REF_ERR_P"    value="120"/>
    <define name="REF_ERR_Q"    value="130"/>
    <define name="REF_ERR_R"    value="80"/>
    <define name="REF_RATE_P"   value="15"/>
    <define name="REF_RATE_Q"   value="15"/>
    <define name="REF_RATE_R"   value="5"/>
    <define name="MAX_R"        value="60" unit="deg/s"/>

    <!-- second order filter parameters -->
    <define name="FILT_CUTOFF"  value="4.0"/>
    <define name="FILT_CUTOFF_R" value="4.0"/>

    <!-- Adaptive Learning Rate -->
    <define name="USE_ADAPTIVE" value="FALSE"/>
    <define name="ADAPTIVE_MU"  value="0.0001"/>

    <!-- Full INDI -->
    <!--COLUMNS: FR BR BL FL AILERONS_RIGHT AILERONS_LEFT MOTOR_PUSH -->
    <!-- control effectiveness All value are divided by INDI_G_SCALING (=1000)-->
    <define name="G1" type="matrix">
		<!--COLUMNS:   FR    BR     BL     FL   AR  AL   TX  -->
      <field name="ROLL"   value="{-15.0, -15.0,  15.0,  15.0, 0., 0.,   0.}"/> <!-- MX - ROLL  -->
      <field name="PITCH"  value="{ 15.0, -15.0, -15.0,  15.0, 0., 0.,   0.}"/> <!-- MY - PITCH -->
      <field name="YAW"    value="{  3.0,  -3.0,   3.0,  -3.0, 0., 0.,   0.}"/> <!-- MZ - YAW   -->
      <field name="THRUST" value="{  -1.,   -1.,   -1.,   -1., 0., 0.,   0.}"/> <!-- FZ         -->
      <field name="THRUST_X" value="{   0.,    0.,    0.,    0., 0., 0.,   0.}"/> <!-- FX         -->
    </define>
    <!-- Ailerons right and left definition are done in scheduler -->    
    
    
    <!--Counter torque effect of spinning up a rotor. This Matrix is added to the YAW line of G1 if(i==2) g1g2[i][j] = (g1[i][j] + g2[j]) / INDI_G_SCALING;-->
    <define name="G2"                       value="{80, -80, 80, -80.0, 0 , 0, 0}"/><!-- TODO -->
    <!-- first order actuator dynamics -->
    <!-- define name="ACT_FREQ"                 value="{10.10, 10.10, 10.10, 10.10}"/ -->
    <define name="ESTIMATION_FILT_CUTOFF"   value="4.0"/>
    <!--Priority for each axis (roll, pitch, yaw and thrust)-->
    <!--define name="WLS_PRIORITIES"           value="{1000, 1000, 1, 100}"/-->
    <!--first order actuator dynamics -->
    <define name="ACT_FREQ"                 value="{12.66, 12.66, 12.66, 12.66, 25.6, 25.6, 12.66}"/>  <!-- WARNING HERE -->
    <define name="ACT_RATE_LIMIT"           value="{9600, 9600, 9600, 9600, 170, 170, 9600}"/>
    <define name="ACT_IS_SERVO"             value="{0, 0, 0, 0, 1, 1, 0}"/>
    <define name="G1_THRUST_X"         value="{   0.,    0.,    0.,    0., 0., 0.,   0.}"/>   <!-- TODO -->
    <define name="ACT_IS_THRUSTER_X"   value="{0, 0, 0, 0, 0, 0, 1}"/> <!--value="{1, 1, 0, 1, 1, 0, 0}"/-->
    <define name="ACT_IS_THRUSTER_Z"   value="{1, 1, 1, 1, 0, 0, 0}"/> <!--value="{1, 1, 1, 1, 1, 0, 0}"/-->
    <define name="NUM_THRUSTERS"       value="4"/>
    <define name="NUM_THRUSTERS_X"     value="1"/>
  </section>
  
<section name ="EFFECTIVE_SCHEDULING">         
    <define name="FLT_CUTOFF_FREQ"                        value="0.001"/> <!-- 0.001 -->
    <define name="EFF_SCHEDULING_QUADPLANE_THRUST_X"      value="1"/> <!-- 15 ? -->
    <define name="EFF_SCHEDULING_QUADPLANE_PITCH"         value="0.5"/> <!-- 0.05 --> 
    <define name="EFF_SCHEDULING_QUADPLANE_ROLL"          value="0.7"/> <!-- 0.07 -->
    <!--define name="MASS"                                   value="0.67"/-->
    <!--define name="STABILIZATION_INDI_WLS_PRIORITIES"      value="{300, 300, 1, 100, 1}"/--> <!-- Roll, Pitch, Yaw, Lift, Thrust WARNING HERE -->
    <!--define name="STABILIZATION_INDI_WLS_WU"              value="{1.3, 1.3, 1.3, 1.3, 1.0, 1.0, 1.3}"/--> <!-- Left Thrust, Right Thrust, Tail Thrust, Mean Tilt, Tilt Diff, Ailerons, Elevator -->

    <!--define name="I_XX_0TILT"                          value="0.005"/--> <!-- X-AXIS MOMENT OF INERTIA AT TILT = 0 -->
    <!--define name="I_YY_0TILT"                          value="0.005"/--> <!-- Y-AXIS MOMENT OF INERTIA AT TILT = 0 -->
    <!--define name="I_ZZ_0TILT"                          value="0.015"/--> <!-- Z-AXIS MOMENT OF INERTIA AT TILT = 0 -->
    <!--define name="STABILIZATION_INDI_ACT_PREF"         value="{0,0,0,8700,0,0,0}"/-->
