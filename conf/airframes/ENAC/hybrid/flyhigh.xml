<!DOCTYPE airframe SYSTEM "../../airframe.dtd">

<airframe name="Flyhigh">

  <description>
    * Autopilot:   TawakiV2
    * Actuators:   4 in 1  
    * Telemetry:   XBee
    * GPS:         datalink
    * RC:          SBUS
  </description>



  <!-- *** FIRMWARE *** -->
  <firmware name="rotorcraft">
    <configure name="RTOS_DEBUG" value="FALSE"/>
    <configure name="PERIODIC_FREQUENCY" value="500"/>
    <configure name="AHRS_PROPAGATE_FREQUENCY" value="$(PERIODIC_FREQUENCY)"/>

    <target name="ap" board="tawaki_2.0">
      <module name="radio_control" type="sbus"/>
      <configure name="BARO_PERIODIC_FREQUENCY" value="50"/>
      <define name="RADIO_KILL_SWITCH" value="RADIO_GAIN1"/>
      <define name="RADIO_CONTROL_THRUST_X"   value="RADIO_GAIN2"/>   <!-- TODO -->
      <!--define name="INS_EKF2_OPTITRACK" value="TRUE"/-->
      <!-- define name="I2C2_CLOCK_SPEED" value="100000"/ --> 
    </target>
    
  <!-- Just for dev, can be supp after  /-->    
    <module name="logger_control_effectiveness"/> 
    <module name="logger" type="control_effectiveness">
      <define name="LOGGER_CONTROL_EFFECTIVENESS_COMMANDS" value="TRUE"/>
      <define name="LOGGER_CONTROL_EFFECTIVENESS_ACTUATORS" value="TRUE"/>
      <define name="LOGGER_CONTROL_EFFECTIVENESS_POS" value="TRUE"/>
      <define name="LOGGER_CONTROL_EFFECTIVENESS_SPEED" value="TRUE"/>
      <define name="LOGGER_CONTROL_EFFECTIVENESS_AIRSPEED" value="TRUE"/>
    </module>
    
    <target name="nps" board="pc">
      <module name="fdm" type="jsbsim"/>
      <module name="radio_control" type="ppm"/>
      <define name="TAWAKIV2_IMU_ROT" value=""/>
      <define name="TAWAKIV2_MAG_ROT" value=""/>
      <!--define name="RADIO_CONTROL_THRUST_X" value="0"/-->      
    </target>

    <module name="telemetry" type="xbee_api"/>
    
	<!-- ACTUATORS IN DSHOT : 4 MOTORS FOR HOOVERING -->
    <module name="actuators" type="dshot">
      <configure name="DSHOT_BIDIR" value="TRUE"/>
    </module>

	<!-- ACTUATORS IN PWM : FORWARD MOTOR + AILERONS -->
    <module name="actuators" type="pwm">
    </module>
    
    <!-- BOARD TYPE -->
    <module name="board" type="tawaki_2.0">
    </module>
    
    <!-- EXTERNAL INSTRUMENT -->
    <!--Extern magneto-->    
    <module name="mag" type="rm3100">
      <configure name="MAG_RM3100_I2C_DEV" value="i2c2"/>
      <define name="MODULE_RM3100_UPDATE_AHRS"    value="TRUE"/>
      <define name="RM3100_CHAN_X" value="1"/>
      <define name="RM3100_CHAN_Y" value="0"/>
      <define name="RM3100_CHAN_Y_SIGN" value="-"/>
    </module>
    
    <!--Airspeed sensor : get the measured airspeed in the messages-->
    <module name="airspeed" type="sdp3x">
      <define name="SDP3X_i2C_DEV" value="i2c2"/>
      <define name="SDP3X_PRESSURE_SCALE" value="16.0"/>
      <define name="SDP3X_PRESSURE_OFFSET" value="-0.1"/>
      <define name="USE_AIRSPEED_SDP3X" value="TRUE"/>
    </module>
    <!--Don't know why but it's needed for getting the airspeed in the state-->
    <module name="air_data">
      <define name="USE_AIRSPEED_AIR_DATA" value="TRUE"/>
    </module>

	<!--  *** MODE GPS *** -->
    <module name="gps" type="ublox">
      <configure name="GPS_BAUD" value="B115200"/>
      <define name="GPS_FIX_TIMEOUT" value="0.5"/>
    </module>
     <!-- INS TYPE : EKF2 -->
    <module name="ins" type="ekf2">
      <define name="INS_EKF2_MAG_ID" value="MAG_RM3100_SENDER_ID"/>
    </module>    
    
	<!-- *** MODE OPTITRACK *** -->    
    <!--module name="gps" type="optitrack"/-->   
        <!-- INS TYPE : EKF2 -->
    <!--module name="ins" type="ext_pose"/-->


	<!-- STABILIZATION TYPE : INDI FOR HOOVERING -->
    <module name="stabilization" type="indi">
            <configure name="INDI_NUM_ACT" value="7"/>
            <configure name="INDI_OUTPUTS" value="5"/>
            <define name="WLS_N_U_MAX"     value="7"/>
            <define name="WLS_N_V_MAX"     value="5"/>
    </module>
    
    <!-- GUIDANCE TYPE : INDI -->
    <module name="guidance" type="indi_hybrid_quadplane"/>

    <!-- NAV TYPE : HYBRID -->    
    <module name="nav" type="hybrid">
      <define name="GUIDANCE_H_USE_REF" value="FALSE"/>
    </module>

    <!-- SCHEDULING  -->
    <module name="eff_scheduling_quadplane"/>
        

    <module name="flight_recorder"/>
    
    <!--module name="lidar_sf30d">
      <configure name="LIDAR_SF30D_I2C_DEV" value="I2C2"/>
    </module-->
        
    <!--module name="trisonica">
      <configure name="TRISONICA_UART" value="UART3"/>
    </module-->
    
  </firmware>
    <!-- *** END FIRMWARE *** -->



  <!-- *** SERVOS *** -->
  <!-- ACTUATORS IN DSHOT : 4 MOTORS FOR HOOVERING -->
  <servos driver="DShot">
    <servo name="FR" no="1" min="0" neutral="100" max="2000"/>
    <servo name="BR" no="2" min="0" neutral="100" max="2000"/>
    <servo name="BL" no="3" min="0" neutral="100" max="2000"/>
    <servo name="FL" no="4" min="0" neutral="100" max="2000"/>
  </servos>

  <!-- ACTUATORS IN PWM : FORWARD MOTOR + AILERONS -->  
  <servos driver="Pwm">  
    <servo name="AILERONS_RIGHT" no="1" min="1275"  neutral="1575" max="1875"/>    <!-- min 870  neutral 1510 max 2150  min="1100" neutral="1500" max="1900"-->  
    <servo name="AILERONS_LEFT"  no="2" min="1270"  neutral="1570" max="1870"/>    <!-- Inverted one : min 870  neutral 1510 max 2150   --> 
    <servo name="MOTOR_PUSH"     no="3" min="1000" neutral="1100" max="2000"/>
  </servos>
  <!-- *** END SERVOS *** -->
  
  
  
  <!-- *** COMMANDS *** -->  
  <commands>
    <axis name="FR"               group="REAL"    failsafe_value="-9600"/>
    <axis name="BR"               group="REAL"    failsafe_value="-9600"/>
    <axis name="BL"               group="REAL"    failsafe_value="-9600"/>
    <axis name="FL"               group="REAL"    failsafe_value="-9600"/>
    <axis name="AILERONS_RIGHT"   group="REAL"    failsafe_value="-9600"/>
    <axis name="AILERONS_LEFT"    group="REAL"    failsafe_value="-9600"/>    
    <axis name="THRUST_X"         group="REAL"    failsafe_value="-9600"/>
    <axis name="ROLL"             group="VIRTUAL" failsafe_value="0"/>
    <axis name="PITCH"            group="VIRTUAL" failsafe_value="0"/>
    <axis name="YAW"              group="VIRTUAL" failsafe_value="0"/>
    <axis name="THRUST"           group="VIRTUAL" failsafe_value="0"/>  
  </commands>
  
  <!-- *** COMMANDS LAWS *** -->    
  <command_laws>
    <call fun="command_set(COMMAND_FR,               autopilot.motors_on ?  actuators_pprz[0] : -MAX_PPRZ)"/>
    <call fun="command_set(COMMAND_BR,               autopilot.motors_on ?  actuators_pprz[1] : -MAX_PPRZ)"/>
    <call fun="command_set(COMMAND_BL,               autopilot.motors_on ?  actuators_pprz[2] : -MAX_PPRZ)"/>
    <call fun="command_set(COMMAND_FL,               autopilot.motors_on ?  actuators_pprz[3] : -MAX_PPRZ)"/>
    <call fun="command_set(COMMAND_AILERONS_RIGHT,   autopilot.motors_on ?  actuators_pprz[4] : 0)"/>
    <call fun="command_set(COMMAND_AILERONS_LEFT,    autopilot.motors_on ?  actuators_pprz[5] : 0)"/>
    <call fun="command_set(COMMAND_THRUST_X,         autopilot.motors_on ?  eff_scheduling_thruster_X() : -MAX_PPRZ)"/>
    <set servo="FR"              value="@FR"/>
    <set servo="BR"              value="@BR"/>
    <set servo="BL"              value="@BL"/>
    <set servo="FL"              value="@FL"/>
    <set servo="AILERONS_RIGHT"  value="@AILERONS_RIGHT"/>
    <set servo="AILERONS_LEFT"   value="@AILERONS_LEFT"/>
    <set servo="MOTOR_PUSH"      value="@THRUST_X"/>
  </command_laws>
    <!-- *** END COMMANDS LAWS *** -->  



  <!-- *** IMU GYRO MAGNETO SECTION *** -->   
  <section name="IMU" prefix="IMU_">
    <define name="ACCEL_CALIB"    type="array">
      <field type="struct">
        <field name="abi_id"      value="24"/>
        <field name="calibrated"  type="struct">
          <field name="neutral"   value="true"/>
          <field name="scale_f"     value="true"/>
          <field name="rotation"  value="true"/>
        </field>
        <field name="neutral" value="3,-7,46" type="int[]"/>
        <field name="scale_f" value="{ 2.4538, 2.4555, 2.4573 }"/>
        <field value="TAWAKIV2_IMU_ROT"/>
      </field>
    </define>
    <define name="GYRO_CALIB"     type="array">
      <field type="struct">
        <field name="abi_id"      value="24"/>
        <field name="calibrated"  type="struct">
          <field name="neutral"   value="false"/>
          <field name="scale"     value="false"/>
          <field name="rotation"  value="true"/>
        </field>
        <field value="TAWAKIV2_IMU_ROT"/>
      </field>
    </define>
    <define name="MAG_CALIB"      type="array">
      <field type="struct">
        <field name="abi_id"      value="3"/>
        <field name="calibrated"  type="struct">
          <field name="neutral"   value="true"/>
          <field name="scale_f"     value="true"/>
          <field name="rotation"  value="true"/>
        </field>
        <field name="neutral" value="-223,-65,26" type="int[]"/>
        <field name="scale_f" value="{ 0.6484, 0.6238, 0.6345 }"/>
        <field value="TAWAKIV2_MAG_ROT"/>
      </field>
      <field type="struct">
        <field name="abi_id" value="5"/>
        <field name="calibrated" type="struct">
          <field name="neutral" value="true"/>
          <field name="scale_f" value="true"/>
        </field>
        <field name="neutral" value="161,238,94" type="int[]"/>
        <field name="scale_f" value="{ 0.6535, 0.6338, 0.6369 }"/>
      </field>
    </define>
    <define name="BODY_TO_IMU_PHI"   value="0." unit="deg"/>
    <define name="BODY_TO_IMU_THETA" value="0." unit="deg"/>
    <define name="BODY_TO_IMU_PSI"   value="90." unit="deg"/>
    
    <define name="IMU_MAG_CALIB" type="array">
      <field type="struct">
        <field name="abi_id" value="5"/>
        <field name="calibrated" type="struct">
          <field name="neutral" value="true"/>
          <field name="scale_f" value="true"/>
        </field>
        <field name="neutral" value="161,238,94" type="int[]"/>
        <field name="scale_f" value="{ 0.6535, 0.6338, 0.6369 }"/>
      </field>
    </define>
   </section>
  <!-- *** END IMU GYRO MAGNETO SECTION *** -->   



  <!-- *** CONFIGURATION INCLUDE *** -->  
  <include href="conf/mag/toulouse_muret.xml"/>
  <!-- *** END CONFIGURATION INCLUDE *** -->  



