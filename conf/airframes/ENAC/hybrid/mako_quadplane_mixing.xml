<!DOCTYPE airframe SYSTEM "../../airframe.dtd">

<airframe name="Mako QuadPlane">

  <description>
    * Autopilot:   TawakiV2
    * Actuators:   4 in 1  
    * Telemetry:   XBee
    * GPS:         datalink
    * RC:          SBUS

    With mixing between INDI and PID in forward flight
  </description>

  <firmware name="rotorcraft">
    <autopilot name="quadplane"/>

    <configure name="RTOS_DEBUG" value="FALSE"/>
    <configure name="PERIODIC_FREQUENCY" value="500"/>

    <target name="ap" board="tawaki_2.0">
      <module name="radio_control" type="sbus"/>
      <configure name="BARO_PERIODIC_FREQUENCY" value="50"/>
      <define name="RADIO_KILL_SWITCH" value="RADIO_GAIN1"/>
      <define name="RADIO_CONTROL_THRUST_X"   value="RADIO_GAIN2"/>   <!-- TODO -->
      <!--define name="INS_EKF2_MAG_ID" value="MAG_RM3100_SENDER_ID"/-->
    </target>
    
    <target name="nps" board="pc">
      <module name="fdm" type="jsbsim"/>
      <module name="radio_control" type="ppm"/>
      <define name="TAWAKIV2_IMU_ROT" value=""/>
      <define name="TAWAKIV2_MAG_ROT" value=""/>
    </target>

    <module name="telemetry" type="xbee_api"/>
    
    <!-- ACTUATORS IN DSHOT : 4 MOTORS FOR HOOVERING -->
    <module name="actuators" type="dshot">
      <configure name="DSHOT_BIDIR" value="TRUE"/>
    </module>

    <!-- ACTUATORS IN PWM : FORWARD MOTOR + AILERONS -->
    <module name="actuators" type="pwm">
    </module>
    
    <!-- BOARD TYPE -->
    <module name="board" type="tawaki_2.0">
    </module>
    
    <!-- EXTERNAL INSTRUMENT -->
    <!--Extern magneto-->    
    <!--module name="mag" type="rm3100">
      <configure name="MAG_RM3100_I2C_DEV" value="i2c2"/>
      <define name="MODULE_RM3100_UPDATE_AHRS" value="TRUE"/>
      <define name="RM3100_CHAN_X" value="1"/>
      <define name="RM3100_CHAN_Y" value="0"/>
      <define name="RM3100_CHAN_Y_SIGN" value="-"/>
    </module-->
    
    <!--Airspeed sensor : get the measured airspeed in the messages-->
    <module name="airspeed" type="sdp3x">
      <define name="SDP3X_i2C_DEV" value="i2c2"/>
      <define name="SDP3X_PRESSURE_SCALE" value="16.0"/>
      <define name="SDP3X_PRESSURE_OFFSET" value="-0.1"/>
      <define name="USE_AIRSPEED_SDP3X" value="TRUE"/>
    </module>
    <!--Don't know why but it's needed for getting the airspeed in the state-->
    <module name="air_data">
      <define name="USE_AIRSPEED_AIR_DATA" value="TRUE"/>
      <define name="USE_AIRSPEED" value="TRUE"/>
    </module>

    <module name="gps" type="ublox">
      <configure name="GPS_BAUD" value="B115200"/>
      <define name="GPS_FIX_TIMEOUT" value="0.5"/>
    </module>
    <module name="ins" type="ekf2">
    </module>    
    
    <module name="stabilization" type="indi">
      <configure name="INDI_NUM_ACT" value="4"/> <!-- only quadcopter part -->
      <configure name="INDI_OUTPUTS" value="4"/>
      <define name="WLS_N_U_MAX"     value="7"/>
      <define name="WLS_N_V_MAX"     value="4"/>
    </module>
    <module name="guidance" type="indi"/>
    <module name="nav" type="hybrid"/>

    <module name="flight_recorder"/>
    <!-- Just for dev, can be supp after  /-->    
    <module name="logger" type="control_effectiveness">
      <define name="LOGGER_CONTROL_EFFECTIVENESS_COMMANDS" value="TRUE"/>
      <define name="LOGGER_CONTROL_EFFECTIVENESS_ACTUATORS" value="TRUE"/>
      <define name="LOGGER_CONTROL_EFFECTIVENESS_POS" value="TRUE"/>
      <define name="LOGGER_CONTROL_EFFECTIVENESS_SPEED" value="TRUE"/>
      <define name="LOGGER_CONTROL_EFFECTIVENESS_AIRSPEED" value="TRUE"/>
    </module>

    <!--module name="lidar_sf30d">
      <configure name="LIDAR_SF30D_I2C_DEV" value="I2C2"/>
    </module-->
        
    <!--module name="trisonica">
      <configure name="TRISONICA_UART" value="UART3"/>
    </module-->
    
  </firmware>

  <servos driver="DShot">
    <servo name="MOTOR_FR" no="2" min="0" neutral="100" max="2000"/>
    <servo name="MOTOR_BR" no="1" min="0" neutral="100" max="2000"/>
    <servo name="MOTOR_BL" no="3" min="0" neutral="100" max="2000"/>
    <servo name="MOTOR_FL" no="4" min="0" neutral="100" max="2000"/>
  </servos>

  <servos driver="Pwm">  
    <servo name="AILEVON_RIGHT" no="1" min="1280"  neutral="1580" max="1880"/>
    <servo name="AILEVON_LEFT"  no="2" min="1150"  neutral="1450" max="1750"/>
    <servo name="MOTOR_PUSHER"  no="3" min="1000" neutral="1000" max="2000"/>
  </servos>
  
  <commands>
    <axis name="MOTOR_FRONT_RIGHT"  group="REAL"    failsafe_value="-9600"/>
    <axis name="MOTOR_BACK_RIGHT"   group="REAL"    failsafe_value="-9600"/>
    <axis name="MOTOR_FRONT_LEFT"   group="REAL"    failsafe_value="-9600"/>
    <axis name="MOTOR_BACK_LEFT"    group="REAL"    failsafe_value="-9600"/>
    <axis name="MOTOR_PUSHER"       group="REAL"    failsafe_value="-9600"/>
    <axis name="ROLL"               group="VIRTUAL" failsafe_value="0"/>
    <axis name="PITCH"              group="VIRTUAL" failsafe_value="0"/>
    <axis name="YAW"                group="VIRTUAL" failsafe_value="0"/>
    <axis name="THRUST"             group="VIRTUAL" failsafe_value="0"/>  
  </commands>
  
  <command_laws>
    <set servo="MOTOR_FR"       value="@MOTOR_FRONT_RIGHT"/>
    <set servo="MOTOR_BR"       value="@MOTOR_BACK_RIGHT"/>
    <set servo="MOTOR_BL"       value="@MOTOR_BACK_LEFT"/>
    <set servo="MOTOR_FL"       value="@MOTOR_FRONT_LEFT"/>
    <set servo="AILEVON_RIGHT"  value="@ROLL + @PITCH"/>
    <set servo="AILEVON_LEFT"   value="@ROLL - @PITCH"/>
    <set servo="MOTOR_PUSHER"   value="@MOTOR_PUSHER"/>
  </command_laws>

  <section name="IMU" prefix="IMU_">
    <define name="ACCEL_CALIB"    type="array">
      <field type="struct">
        <field name="abi_id"      value="24"/>
        <field name="calibrated"  type="struct">
          <field name="neutral"   value="true"/>
          <field name="scale_f"     value="true"/>
          <field name="rotation"  value="true"/>
        </field>
        <field name="neutral" value="-17,-8,-30" type="int[]"/>
        <field name="scale_f" value="{ 2.4480, 2.4523, 2.4596 }"/>
        <field value="TAWAKIV2_IMU_ROT"/>
      </field>
    </define>
    <define name="GYRO_CALIB"     type="array">
      <field type="struct">
        <field name="abi_id"      value="24"/>
        <field name="calibrated"  type="struct">
          <field name="neutral"   value="false"/>
          <field name="scale"     value="false"/>
          <field name="rotation"  value="true"/>
        </field>
        <field value="TAWAKIV2_IMU_ROT"/>
      </field>
    </define>
    <define name="MAG_CALIB"      type="array">
      <field type="struct">
        <field name="abi_id"      value="3"/>
        <field name="calibrated"  type="struct">
          <field name="neutral"   value="true"/>
          <field name="scale_f"     value="true"/>
          <field name="rotation"  value="true"/>
        </field>
        <field name="neutral" value="-1111,1642,-1081" type="int[]"/>
        <field name="scale_f" value="{ 0.6598, 0.6614, 0.6754 }"/>
        <field value="TAWAKIV2_MAG_ROT"/>
      </field>
      <!--field type="struct">
        <field name="abi_id" value="5"/>
        <field name="calibrated" type="struct">
          <field name="neutral" value="true"/>
          <field name="scale_f" value="true"/>
        </field>
        <field name="neutral" value="161,238,94" type="int[]"/>
        <field name="scale_f" value="{ 0.6535, 0.6338, 0.6369 }"/>
      </field-->
    </define>
    <define name="BODY_TO_IMU_PHI"   value="0." unit="deg"/>
    <define name="BODY_TO_IMU_THETA" value="0." unit="deg"/>
    <define name="BODY_TO_IMU_PSI"   value="0." unit="deg"/>
    
  </section>

  <include href="conf/mag/toulouse_muret.xml"/>

  <section name="STABILIZATION_ATTITUDE" prefix="STABILIZATION_ATTITUDE_">
    <!-- setpoint limits for attitude stabilization rc flight -->
    <define name="SP_MAX_PHI"   value="45" unit="deg"/>
    <define name="SP_MAX_THETA" value="45" unit="deg"/>
    <define name="SP_MAX_R"     value="90" unit="deg/s"/>
    <define name="DEADBAND_R"   value="50"/>
  </section>

  <section name="STABILIZATION_ATTITUDE_INDI" prefix="STABILIZATION_INDI_">
    <!-- reference acceleration for attitude control -->
    <define name="REF_ERR_P"    value="80"/>
    <define name="REF_ERR_Q"    value="130"/>
    <define name="REF_ERR_R"    value="40"/>
    <define name="REF_RATE_P"   value="12"/>
    <define name="REF_RATE_Q"   value="15"/>
    <define name="REF_RATE_R"   value="6"/>
    <define name="MAX_R"        value="60" unit="deg/s"/>

    <!-- second order filter parameters -->
    <define name="FILT_CUTOFF"  value="4.0"/>
    <define name="FILT_CUTOFF_R" value="4.0"/>

    <!-- Adaptive Learning Rate -->
    <define name="USE_ADAPTIVE" value="FALSE"/>
    <define name="ESTIMATION_FILT_CUTOFF"   value="4.0"/>
    <define name="ADAPTIVE_MU"  value="0.0001"/>

    <!-- Full INDI -->
    <!--COLUMNS: FR BR BL FL -->
    <!-- control effectiveness All value are divided by INDI_G_SCALING (=1000)-->
    <define name="G1" type="matrix">
      <field name="ROLL"     value="{-2.8,  -2.8,   2.8,   2.8}"/> <!-- MX - ROLL  -->
      <field name="PITCH"    value="{ 6.4,  -6.4,  -6.4,   6.4}"/> <!-- MY - PITCH -->
      <field name="YAW"      value="{ 1.4,  -1.4,   1.4,  -1.4}"/> <!-- MZ - YAW   -->
      <field name="THRUST"   value="{-0.46, -0.46, -0.46, -0.46}"/> <!-- FZ         -->
    </define>
    
    <define name="G2"             value="{10, -20, 20, -10}"/>
    <define name="WLS_PRIORITIES" value="{1000, 1000, 1, 100}"/>
    <define name="ACT_FREQ"       value="{27., 27., 27., 27.}"/>
    <define name="ACT_RATE_LIMIT" value="{9600, 9600, 9600, 9600}"/>
    <define name="ACT_IS_SERVO"   value="{0, 0, 0, 0}"/>
  </section>
  
  <section name="STABILIZATION_PLANE" prefix="STABILIZATION_PLANE_">
    <define name="PHI_PGAIN" value="10000"/>
    <define name="PHI_IGAIN" value="50"/>
    <define name="PHI_DGAIN" value="600"/>
    <define name="THETA_PGAIN" value="8000"/>
    <define name="THETA_IGAIN" value="30"/>
    <define name="THETA_DGAIN" value="1000"/>
  </section>

  <section name="GUIDANCE_V" prefix="GUIDANCE_V_"> 
    <define name="REF_MIN_ZDD" value="-0.4*9.81"/>
    <define name="REF_MAX_ZDD" value=" 0.4*9.81"/>
    <define name="REF_MIN_ZD" value="-2."/>
    <define name="REF_MAX_ZD" value=" 2."/>
    <define name="NOMINAL_HOVER_THROTTLE" value="0.35"/>
    <define name="ADAPT_THROTTLE_ENABLED" value="TRUE"/>
  </section>

  <section name="GUIDANCE_H" prefix="GUIDANCE_H_"> 
    <define name="MAX_BANK" value="30" unit="deg"/>
    <define name="USE_SPEED_REF" value="TRUE"/>    
    <define name="PGAIN" value="41"/>
    <define name="DGAIN" value="108"/>
    <define name="IGAIN" value="20"/>
    <define name="AGAIN" value="0"/>
    <define name="REF_MAX_SPEED" value="1."/>
    <define name="REF_MAX_ACCEL" value="2."/>
  </section>

  <section name="GUIDANCE_INDI" prefix="GUIDANCE_INDI_">
    <define name="THRUST_DYNAMICS_FREQ" value="30.5"/>
  </section>

  <section name="GUIDANCE_PLANE" prefix="GUIDANCE_PLANE_">
    <define name="COURSE_KP" value="1.0"/>
    <define name="COURSE_KD" value="0.1"/>
    <define name="CLIMB_KP" value="0.1"/>
    <define name="PITCH_KP" value="0.5"/>
    <define name="PITCH_KD" value="0.1"/>
    <define name="PITCH_KI" value="0."/>
    <define name="THROTTLE_KP" value="0.1"/>
    <define name="THROTTLE_KD" value="0.1"/>
    <define name="THROTTLE_KI" value="0."/>
    <define name="NOMINAL_THROTTLE" value="0.4"/>
    <define name="PITCH_TRIM" value="2." unit="deg"/>  <!-- TODO : check this value -->  
  </section>  

  <section name="NAV">
    <define name="ARRIVED_AT_WAYPOINT" value="2."/>
    <define name="NAV_CLIMB_VSPEED" value="1.5"/>
    <define name="NAV_DESCEND_VSPEED" value="-1."/>
    <define name="DEFAULT_CIRCLE_RADIUS" value="50"/>
  </section>
  
  <section name="BAT">
    <define name="CATASTROPHIC_BAT_LEVEL" value="9.2" unit="V"/>
    <define name="CRITIC_BAT_LEVEL" value="9.4" unit="V"/>
    <define name="LOW_BAT_LEVEL" value="10." unit="V"/>
    <define name="MAX_BAT_LEVEL" value="12.4" unit="V"/>
    <define name="BAT_NB_CELLS" value="3"/>
  </section>

  <section name="AUTOPILOT">
    <define name="MODE_STARTUP" value="AP_MODE_NAV"/>
    <define name="MODE_MANUAL" value="AP_MODE_ATTITUDE"/>
    <define name="MODE_AUTO1" value="AP_MODE_FORWARD"/>
    <define name="MODE_AUTO2" value="AP_MODE_NAV"/>
    <!--define name="MODE_STARTUP" value="AP_MODE_KILL"/>
    <define name="MODE_MANUAL" value="AP_MODE_MANUAL"/>
    <define name="MODE_AUTO1" value="AP_MODE_ATTITUDE"/>
    <define name="MODE_AUTO2" value="AP_MODE_FORWARD"/-->
    <define name="FAILSAFE_FIXED_THROTTLE" value="0.4"/>
  </section>

  <section name="GCS">
    <define name="ALT_SHIFT_PLUS_PLUS" value="3"/>
    <define name="ALT_SHIFT_PLUS" value="1"/>
    <define name="ALT_SHIFT_MINUS" value="-0.5"/>
  </section>

  <section name="SIMULATOR" prefix="NPS_">
    <define name="JSBSIM_MODEL" value="flyhigh_quadplane" type="string"/>
    <define name="USE_COMMANDS" value="TRUE"/>
  </section>

</airframe>

